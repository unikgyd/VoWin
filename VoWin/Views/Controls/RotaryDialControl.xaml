<UserControl
  x:Class="VoWin.Views.Controls.RotaryDialControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  Width="280"
  Height="280"
>
  <UserControl.Resources>
    <!-- Style for visible numbered holes on the rotating rotor -->
    <Style x:Key="RotaryHoleStyle" TargetType="Border">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.16" Color="#000000" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
    <!-- Layer 0: Outer Bezel & Base Plate (Fixed) -->
    <Border
      Width="280"
      Height="280"
      CornerRadius="140"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="2"
    >
      <Border.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.12" Color="#000000" />
      </Border.Effect>
    </Border>

    <!-- Metallic Rim Accent -->
    <Border
      Width="272"
      Height="272"
      CornerRadius="136"
      BorderThickness="1.5"
      Opacity="0.75"
    >
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#CBD5E1" Offset="0" />
          <GradientStop Color="#94A3B8" Offset="0.5" />
          <GradientStop Color="#E2E8F0" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
    </Border>

    <!-- Inner Dial Face Base Ring -->
    <Border
      Width="256"
      Height="256"
      CornerRadius="128"
      Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
    />

    <!-- Subtle Dial Track Guide Ring -->
    <Ellipse
      Width="192"
      Height="192"
      Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
      StrokeThickness="1"
      StrokeDashArray="2,4"
      Opacity="0.5"
      IsHitTestVisible="False"
    />

    <!-- Layer 1: Rotating Finger Wheel with Clear Numerals (Rotor) -->
    <Canvas
      x:Name="RotorCanvas"
      Width="280"
      Height="280"
      RenderTransformOrigin="0.5, 0.5"
      Background="Transparent"
    >
      <Canvas.RenderTransform>
        <RotateTransform x:Name="RotorTransform" Angle="0" CenterX="140" CenterY="140" />
      </Canvas.RenderTransform>

      <!-- Transparent disc body with subtle border -->
      <Border
        Canvas.Left="14"
        Canvas.Top="14"
        Width="252"
        Height="252"
        CornerRadius="126"
        BorderBrush="#2594A3B8"
        BorderThickness="1.5"
        Background="#05000000"
        IsHitTestVisible="False"
      />

      <!-- 10 Distinct Numbered Finger Holes (Numbers move directly with the wheel) -->
      <!-- Hole 1 (Angle: 68 deg) -->
      <Border
        Canvas.Left="207"
        Canvas.Top="82"
        Tag="1"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="1" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 2 (Angle: 43 deg) -->
      <Border
        Canvas.Left="183.5"
        Canvas.Top="47.8"
        Tag="2"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="2" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 3 (Angle: 18 deg) -->
      <Border
        Canvas.Left="147.7"
        Canvas.Top="26.7"
        Tag="3"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="3" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 4 (Angle: 353 deg) -->
      <Border
        Canvas.Left="106.3"
        Canvas.Top="22.7"
        Tag="4"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="4" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 5 (Angle: 328 deg) -->
      <Border
        Canvas.Left="67.1"
        Canvas.Top="36.6"
        Tag="5"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="5" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 6 (Angle: 303 deg) -->
      <Border
        Canvas.Left="37.5"
        Canvas.Top="65.7"
        Tag="6"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="6" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 7 (Angle: 278 deg) -->
      <Border
        Canvas.Left="22.9"
        Canvas.Top="104.6"
        Tag="7"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="7" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 8 (Angle: 253 deg) -->
      <Border
        Canvas.Left="26.2"
        Canvas.Top="146.1"
        Tag="8"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="8" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 9 (Angle: 228 deg) -->
      <Border
        Canvas.Left="46.7"
        Canvas.Top="182.2"
        Tag="9"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="9" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Hole 0 (Angle: 203 deg) -->
      <Border
        Canvas.Left="80.5"
        Canvas.Top="206.4"
        Tag="0"
        Style="{StaticResource RotaryHoleStyle}"
        MouseLeftButtonDown="OnHoleMouseDown"
        MouseEnter="OnHoleMouseEnter"
        MouseLeave="OnHoleMouseLeave"
      >
        <TextBlock Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Canvas>

    <!-- Layer 2: Physical Finger Stop Hook (Fixed at ~140 degrees) -->
    <Canvas Width="280" Height="280" IsHitTestVisible="False">
      <!-- Metallic Finger Stop Bracket -->
      <Path
        Data="M 238,206 Q 212,220 196,208 L 200,218 Q 216,228 242,212 Z"
        Fill="#64748B"
        Stroke="#475569"
        StrokeThickness="1"
      >
        <Path.Effect>
          <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.35" Color="#000000" />
        </Path.Effect>
      </Path>
      <!-- Stopper bumper dot -->
      <Ellipse
        Canvas.Left="192"
        Canvas.Top="204"
        Width="12"
        Height="12"
        Fill="#E2E8F0"
        Stroke="#DC2626"
        StrokeThickness="1.5"
      >
        <Ellipse.Effect>
          <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3" Color="#000000" />
        </Ellipse.Effect>
      </Ellipse>
    </Canvas>

    <!-- Layer 3: Stationary Center Hub with Live Digit Feedback -->
    <Border
      Width="84"
      Height="84"
      CornerRadius="42"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="2"
      IsHitTestVisible="False"
    >
      <Border.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Color="#000000" />
      </Border.Effect>
      <Grid>
        <!-- Center Metallic Inset Ring -->
        <Border
          Width="70"
          Height="70"
          CornerRadius="35"
          Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
        >
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Idle Hub View: VoWin Logo -->
            <StackPanel x:Name="DefaultHubView" VerticalAlignment="Center" HorizontalAlignment="Center">
              <ui:SymbolIcon
                Symbol="Call24"
                FontSize="20"
                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                HorizontalAlignment="Center"
              />
              <TextBlock
                Text="VoWin"
                FontSize="10"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                Margin="0,2,0,0"
              />
            </StackPanel>

            <!-- Active Dialing Hub View: Huge Digit Display -->
            <StackPanel x:Name="ActiveDigitHubView" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <TextBlock
                x:Name="TxtActiveDigit"
                Text="8"
                FontSize="30"
                FontWeight="Bold"
                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                HorizontalAlignment="Center"
                Margin="0,-4,0,-2"
              />
              <TextBlock
                Text="旋拨中"
                FontSize="9"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center"
              />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
