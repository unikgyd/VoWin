<Window
  x:Class="VoWin.Views.Windows.IncomingSmsFloatingWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="新短信提醒"
  Width="420"
  Height="162"
  AllowsTransparency="True"
  Background="Transparent"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Topmost="True"
  WindowStyle="None"
  WindowStartupLocation="Manual"
  mc:Ignorable="d"
>
  <Window.Resources>
    <!-- Soft Glow Drop Shadow -->
    <DropShadowEffect
      x:Key="FloatingShadow"
      BlurRadius="24"
      Direction="270"
      Opacity="0.75"
      ShadowDepth="6"
      Color="#000000"
    />
  </Window.Resources>

  <Border
    Margin="10"
    Background="#F2141724"
    BorderBrush="#4060A5FA"
    BorderThickness="1.2"
    CornerRadius="16"
    Effect="{StaticResource FloatingShadow}"
    ClipToBounds="True"
  >
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Main Content Area -->
      <Grid Grid.Row="0" Margin="16,14,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Row: Icon, Badges, Sender, Time, Close Button -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Icon Badge -->
          <Border
            Grid.Column="0"
            Width="38"
            Height="38"
            VerticalAlignment="Center"
            Background="#252563EB"
            BorderBrush="#3B82F6"
            BorderThickness="1.2"
            CornerRadius="19"
            Margin="0,0,12,0"
          >
            <ui:SymbolIcon
              x:Name="IconBadge"
              FontSize="18"
              Foreground="#60A5FA"
              Symbol="Key24"
            />
          </Border>

          <!-- Middle Info (Badge, Slot, Sender, Time) -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border
                x:Name="BorderOtpBadge"
                Padding="6,1.5"
                Background="#2563EB"
                CornerRadius="4"
                Margin="0,0,6,0"
              >
                <TextBlock
                  x:Name="TxtTypeBadge"
                  FontSize="10"
                  FontWeight="Bold"
                  Foreground="White"
                  Text="验证码短信"
                />
              </Border>

              <Border
                Padding="6,1.5"
                Background="#2038BDF8"
                CornerRadius="4"
                Margin="0,0,6,0"
              >
                <TextBlock
                  x:Name="TxtSlotBadge"
                  FontSize="10"
                  FontWeight="SemiBold"
                  Foreground="#38BDF8"
                  Text="SIM 1"
                />
              </Border>

              <TextBlock
                x:Name="TxtTime"
                FontSize="10"
                Foreground="#94A3B8"
                VerticalAlignment="Center"
                Text="刚刚"
              />
            </StackPanel>

            <!-- Sender Number -->
            <TextBlock
              x:Name="TxtSender"
              FontSize="14"
              FontWeight="Bold"
              Foreground="White"
              Margin="0,2,0,0"
              TextTrimming="CharacterEllipsis"
              MaxWidth="230"
              Text="1069xxxx"
            />
          </StackPanel>

          <!-- Right: Close Button -->
          <Button
            Grid.Column="2"
            x:Name="BtnClose"
            Width="26"
            Height="26"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnClose_Click"
            ToolTip="关闭 (Esc)"
          >
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13">
                  <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#30FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>

        <!-- Message Body Snippet -->
        <TextBlock
          Grid.Row="1"
          x:Name="TxtMessageBody"
          Margin="0,6,0,8"
          FontSize="12"
          Foreground="#CBD5E1"
          LineHeight="17"
          MaxHeight="34"
          TextTrimming="CharacterEllipsis"
          TextWrapping="Wrap"
          VerticalAlignment="Center"
          Text="正在接收短信内容..."
        />

        <!-- Action Row -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Left: Extracted OTP Code display -->
          <StackPanel
            x:Name="PanelOtpDisplay"
            Grid.Column="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
          >
            <TextBlock
              FontSize="12"
              Foreground="#94A3B8"
              VerticalAlignment="Center"
              Text="验证码："
            />
            <TextBlock
              x:Name="TxtOtpCode"
              FontSize="18"
              FontWeight="Bold"
              Foreground="#38BDF8"
              FontFamily="Consolas, Segoe UI"
              VerticalAlignment="Center"
              Text="------"
            />
          </StackPanel>

          <!-- Right: Copy Button -->
          <Button
            Grid.Column="1"
            x:Name="BtnCopyAction"
            Height="30"
            Padding="12,0"
            Background="#2563EB"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnCopyAction_Click"
            ToolTip="点击复制验证码"
          >
            <Button.Resources>
              <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </Button.Resources>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon
                x:Name="IconCopyBtn"
                Symbol="Copy24"
                FontSize="13"
                Foreground="White"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
              />
              <TextBlock
                x:Name="TxtBtnText"
                Text="复制验证码"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>

      <!-- Bottom Progress Bar (10s Countdown) -->
      <Grid Grid.Row="1" Height="3" Background="#1E293B">
        <Border
          x:Name="ProgressBarTimeout"
          Height="3"
          HorizontalAlignment="Left"
          Background="#2563EB"
          Width="400"
        />
      </Grid>
    </Grid>
  </Border>
</Window>
