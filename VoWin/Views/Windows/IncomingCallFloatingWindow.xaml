<Window
  x:Class="VoWin.Views.Windows.IncomingCallFloatingWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="来电提醒"
  Width="380"
  Height="136"
  AllowsTransparency="True"
  Background="Transparent"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Topmost="True"
  WindowStyle="None"
  WindowStartupLocation="Manual"
  mc:Ignorable="d"
>
  <Window.Resources>
    <!-- Soft Glow Drop Shadow -->
    <DropShadowEffect
      x:Key="FloatingShadow"
      BlurRadius="24"
      Direction="270"
      Opacity="0.65"
      ShadowDepth="6"
      Color="#000000"
    />
  </Window.Resources>

  <Border
    Margin="10"
    Background="{DynamicResource AppFloatingSurfaceBrush}"
    BorderBrush="{DynamicResource AppFloatingBorderBrush}"
    BorderThickness="1.2"
    CornerRadius="18"
    Effect="{StaticResource FloatingShadow}"
  >
    <Grid Margin="16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left: Animated Ringing Call Avatar -->
      <Border
        Grid.Column="0"
        Width="48"
        Height="48"
        VerticalAlignment="Center"
        Background="{DynamicResource AppFloatingSuccessSoftBrush}"
        BorderBrush="{DynamicResource AppSuccessBrush}"
        BorderThickness="1.5"
        CornerRadius="24"
      >
        <ui:SymbolIcon
          FontSize="24"
          Foreground="{DynamicResource AppSuccessBrush}"
          Symbol="Call24"
        />
      </Border>

      <!-- Center: Caller Info & Status -->
      <StackPanel
        Grid.Column="1"
        Margin="14,0,10,0"
        VerticalAlignment="Center"
      >
        <StackPanel Orientation="Horizontal">
          <TextBlock
            FontSize="11"
            FontWeight="Medium"
            Foreground="{DynamicResource AppFloatingTextTertiaryBrush}"
            Text="收到蜂窝 / VoWiFi 来电"
          />
          <Border
            Margin="6,0,0,0"
            Padding="5,1"
            Background="{DynamicResource AppFloatingSuccessSoftBrush}"
            CornerRadius="4"
          >
            <TextBlock
              x:Name="TxtSlotBadge"
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AppSuccessBrush}"
              Text="SIM 1"
            />
          </Border>
        </StackPanel>

        <!-- Large Caller Number -->
        <TextBlock
          x:Name="TxtCallerNumber"
          Margin="0,2,0,0"
          FontSize="19"
          FontWeight="Bold"
          Foreground="{DynamicResource AppFloatingTextPrimaryBrush}"
          Text="10086"
          TextTrimming="CharacterEllipsis"
        />

        <TextBlock
          x:Name="TxtCallSubtext"
          FontSize="11"
          Foreground="{DynamicResource AppFloatingTextPrimaryBrush}"
          Text="AMR-WB 16kHz 高清音频呼叫"
        />
      </StackPanel>

      <!-- Right: Answer & Reject Action Buttons -->
      <StackPanel
        Grid.Column="2"
        Orientation="Horizontal"
        VerticalAlignment="Center"
      >
        <!-- Answer Button (Green) -->
        <Button
          x:Name="BtnAnswer"
          Width="42"
          Height="42"
          Margin="0,0,8,0"
          Background="{DynamicResource AppSuccessBrush}"
          BorderThickness="0"
          Click="BtnAnswer_Click"
          Cursor="Hand"
          ToolTip="接听电话"
        >
          <Button.Resources>
            <Style TargetType="Border">
              <Setter Property="CornerRadius" Value="21" />
            </Style>
          </Button.Resources>
          <ui:SymbolIcon
            FontSize="20"
            Foreground="White"
            Symbol="Call24"
          />
        </Button>

        <!-- Reject Button (Red) -->
        <Button
          x:Name="BtnReject"
          Width="42"
          Height="42"
          Background="{DynamicResource AppDangerBrush}"
          BorderThickness="0"
          Click="BtnReject_Click"
          Cursor="Hand"
          ToolTip="挂断 / 拒接"
        >
          <Button.Resources>
            <Style TargetType="Border">
              <Setter Property="CornerRadius" Value="21" />
            </Style>
          </Button.Resources>
          <ui:SymbolIcon
            FontSize="20"
            Foreground="White"
            Symbol="CallDismiss24"
          />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
