<Page
  x:Class="VoWin.Views.Pages.RemoteControlPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="远程控制"
  d:DataContext="{d:DesignInstance vm:RemoteControlViewModel, IsDesignTimeCreatable=False}"
  Background="Transparent"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  PreviewMouseWheel="OnPreviewMouseWheel"
  mc:Ignorable="d">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <Grid Margin="32,24,32,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="远程控制" />
        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="直接连接腾讯微信 iLink 与 QQ 官方机器人协议；后台运行，不阻塞电话和短信界面。" />
      </StackPanel>
      <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary" Content="保存并重连"
                 Command="{Binding ViewModel.SaveCommand}" />
    </Grid>

    <ScrollViewer x:Name="RemoteScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="920" HorizontalAlignment="Left">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Padding="18" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <DockPanel>
                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ViewModel.WeixinEnabled}" Content="启用" />
                <StackPanel>
                  <TextBlock FontSize="19" FontWeight="SemiBold" Text="微信 ClawBot" />
                  <TextBlock Margin="0,3,0,0" Foreground="#10B981" Text="腾讯官方 iLink 协议" />
                </StackPanel>
              </DockPanel>
              <Border Margin="0,14,0,14" Padding="10" CornerRadius="8" Background="#1210B981">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.WeixinStatus}" TextWrapping="Wrap" />
                  <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.WeixinAccount}" />
                </StackPanel>
              </Border>
              <TextBlock Margin="0,0,0,6" Text="API 地址" />
              <TextBox Margin="0,0,0,12" Text="{Binding ViewModel.WeixinBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,0,0,6" Text="授权用户 ID（逗号分隔）" />
              <TextBox Margin="0,0,0,14" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                       Text="{Binding ViewModel.WeixinAllowedUsers, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button HorizontalAlignment="Left" Appearance="Primary" Content="微信扫码登录"
                         Command="{Binding ViewModel.LoginWeixinCommand}" />
              <Image Margin="0,14,0,0" Width="260" Height="260" Stretch="None" HorizontalAlignment="Left"
                     Source="{Binding ViewModel.WeixinQrImage}">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <Trigger Property="Source" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
              <StackPanel Margin="0,12,0,0" Visibility="{Binding ViewModel.WeixinNeedsVerificationCode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,0,6" Text="微信显示的配对码" />
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="提交并继续"
                             Command="{Binding ViewModel.ContinueWeixinLoginCommand}" />
                  <TextBox Text="{Binding ViewModel.WeixinVerificationCode, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Padding="18" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <DockPanel>
                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ViewModel.QqEnabled}" Content="启用" />
                <StackPanel>
                  <TextBlock FontSize="19" FontWeight="SemiBold" Text="QQ 机器人" />
                  <TextBlock Margin="0,3,0,0" Foreground="#10B981" Text="腾讯官方 Bot API / Gateway" />
                </StackPanel>
              </DockPanel>
              <Border Margin="0,14,0,14" Padding="10" CornerRadius="8" Background="#1210B981">
                <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.QqStatus}" TextWrapping="Wrap" />
              </Border>
              <TextBlock Margin="0,0,0,6" Text="机器人 AppID" />
              <TextBox Margin="0,0,0,12" Text="{Binding ViewModel.QqAppId, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,0,0,6" Text="机器人 AppSecret" />
              <PasswordBox x:Name="QqSecretBox" Margin="0,0,0,12" PasswordChanged="OnQqSecretChanged" />
              <TextBlock Margin="0,0,0,6" Text="授权 QQ 用户 OpenID（逗号分隔）" />
              <TextBox Margin="0,0,0,14" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap"
                       Text="{Binding ViewModel.QqAllowedUsers, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button HorizontalAlignment="Left" Content="验证官方凭据" Command="{Binding ViewModel.TestQqCommand}" />
              <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="在 QQ 开放平台创建机器人并开通 C2C/群消息事件。VoWin 主动连接官方 Gateway，无需公网回调地址。" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Margin="0,16,0,0" Padding="18" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="授权与通知" />
              <TextBlock Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="未授权用户无法查询短信、拨号或更改设备状态。可生成一次性配对码绑定新用户。" />
              <ui:Button HorizontalAlignment="Left" Content="生成一次性配对码" Command="{Binding ViewModel.CreatePairingCodeCommand}" />
              <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Foreground="#10B981" Text="{Binding ViewModel.PairingStatus}" />
              <ui:ToggleSwitch Margin="0,16,0,0" IsChecked="{Binding ViewModel.NotifyIncomingSms}" Content="推送收到的短信" />
              <ui:ToggleSwitch Margin="0,10,0,0" IsChecked="{Binding ViewModel.NotifyOtpOnly}" Content="只推送含验证码的短信" />
              <ui:ToggleSwitch Margin="0,10,0,0" IsChecked="{Binding ViewModel.NotifyIncomingCalls}" Content="推送来电提醒" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="支持的命令" />
              <TextBlock Margin="0,8,0,0" FontFamily="Consolas" LineHeight="22" TextWrapping="Wrap"
                         Text="状态&#x0a;验证码 [数量]&#x0a;短信 &lt;号码&gt; &lt;内容&gt;&#x0a;拨号 &lt;号码&gt;&#x0a;接听 / 拒接 / 挂断&#x0a;卡片 / 切卡 &lt;序号或ID&gt;&#x0a;VoWiFi 开|关&#x0a;飞行模式 开|关&#x0a;刷新" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="0,16,0,0" Padding="16" CornerRadius="10" Background="#1010B981"
                BorderBrush="#4010B981" BorderThickness="1">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="运行状态" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ViewModel.LastActivity}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding ViewModel.OperationStatus}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
