<Page
  x:Class="VoWin.Views.Pages.SystemStatusPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:controls="clr-namespace:VoWin.Views.Controls"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="系统状态"
  d:DataContext="{d:DesignInstance vm:SystemStatusViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="750"
  d:DesignWidth="1200"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource AppTextPrimaryBrush}"
  Foreground="{DynamicResource AppTextPrimaryBrush}"
  ScrollViewer.VerticalScrollBarVisibility="Disabled"
  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
    <helpers:SignalBarsToSymbolConverter x:Key="SignalBarsSymbol" />
    <Style TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Padding="14,10" CornerRadius="10" Background="{DynamicResource AppCardBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
              <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Grid Background="Transparent" MinHeight="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown20" FontSize="14" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                      </Grid>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter ContentSource="Header" />
                </ToggleButton>
                <ContentPresenter x:Name="Expansion" Margin="0,10,0,0" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expansion" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Style for Filter Segment Buttons -->
    <Style x:Key="LogFilterButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Appearance" Value="Transparent" />
    </Style>
  </Page.Resources>

  <Grid Margin="24,18,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ================= TOP HEADER (Page Title + Equipment Selector + Mutually Exclusive Single Action) ================= -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Page Title & Slot Switcher -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock
          Style="{DynamicResource AppPageTitleStyle}"
          VerticalAlignment="Center"
          Text="系统状态"
          Margin="0,0,14,0"
        />

        <!-- Current Slot Selector Badge -->
        <Border
          Padding="8,3"
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          VerticalAlignment="Center"
        >
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Sim24" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="通信设备: " VerticalAlignment="Center" />
            <ComboBox
              ItemsSource="{Binding Slots}"
              SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
              DisplayMemberPath="DisplayTitle"
              MinWidth="130"
              MaxWidth="270"
              Height="26"
              Padding="6,1"
              BorderThickness="0"
              Background="Transparent"
              VerticalAlignment="Center"
            />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Header Actions: Mutually Exclusive Single Action + Refresh -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:ProgressRing
          Width="16"
          Height="16"
          Margin="0,0,10,0"
          IsIndeterminate="True"
          Foreground="{DynamicResource AppWarningBrush}"
          Visibility="{Binding IsTelephonyBusy, Converter={StaticResource BoolToVis}}"
        />

        <ui:Button
          Margin="0,0,8,0"
          Appearance="Primary"
          Command="{Binding ExecutePrimaryActionCommand}"
          Icon="{ui:SymbolIcon Symbol=Play24}"
          Content="{Binding TelephonyActionText, Mode=OneWay}"
          IsEnabled="{Binding CanExecuteTelephonyAction, Mode=OneWay}"
        />

        <!-- Refresh Telemetry Button -->
        <ui:Button
          Appearance="Secondary"
          Command="{Binding RefreshMetricsCommand}"
          IsEnabled="{Binding CanChooseTelephonyMode}"
          Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
          Content="刷新状态"
        />
      </StackPanel>
    </Grid>

    <!-- ================= MAIN CONTENT (Left 70%~75%, Right Collapsible Log 25%~30%) ================= -->
    <Grid x:Name="StatusContentGrid" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="480" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- ================= LEFT COLUMN: Status Telemetry & Quality Dashboard ================= -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
        <StackPanel>

          <ListBox ItemsSource="{Binding ModuleInstances}" SelectedItem="{Binding SelectedModuleInstance, Mode=TwoWay}"
                   AutomationProperties.Name="模组实例" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,14"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Template"><Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="InstanceTile" Padding="12,9" MinWidth="160" MaxWidth="270" CornerRadius="8"
                            Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="InstanceTile" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                        <Setter TargetName="InstanceTile" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InstanceTile" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding Port}" ToolTip="{Binding LineSummary}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                <TextBlock Text="{Binding SimSummary}" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" />
                <controls:GatewayStatusPanel IsCompact="True" Margin="0,5,0,0" Slot="{Binding Slot}"
                    Service="{Binding DataContext.GatewayService, RelativeSource={RelativeSource AncestorType=Page}}" />
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>

          <controls:GatewayStatusPanel x:Name="GatewayStatus" Margin="0,0,0,14"
              IsDense="True" Service="{Binding GatewayService}" Slot="{Binding SelectedSlot}" />
          <Border Margin="0,0,0,14" Padding="18,16" CornerRadius="12"
                  Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="蜂窝线路" Margin="0,0,0,12" />
              <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                         Text="{Binding TelephonyUsageHint}" ToolTip="{Binding TelephonyDetail}" TextWrapping="Wrap">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                  <DataTrigger Binding="{Binding TelephonyUsageHint}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <ListBox ItemsSource="{Binding CellularModes}" SelectedItem="{Binding SelectedTelephonyMode, Mode=TwoWay}"
                       BorderThickness="0" Padding="0" Background="Transparent"
                       HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="蜂窝 IMS 模式" IsEnabled="{Binding CanChooseTelephonyMode}">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding DataContext.CanChooseTelephonyMode, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="ModeCard" Padding="12" CornerRadius="8" BorderThickness="2"
                                  BorderBrush="Transparent" Background="{DynamicResource AppInputBrush}">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ModeCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                              <Setter TargetName="ModeCard" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ModeCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter TargetName="ModeCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="ModeCard" Property="Opacity" Value="0.55" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                        <ui:SymbolIcon Grid.Column="1" Symbol="CheckmarkCircle20" Foreground="{DynamicResource AppAccentBrush}" FontSize="14" Margin="4,0,0,0"
                                       Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
                      </Grid>
                      <TextBlock Margin="0,5,0,8" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <CheckBox Margin="0,14,0,0" Content="启动时连接蜂窝 IMS"
                        IsChecked="{Binding AutoConnectTelephony, Mode=TwoWay}" IsEnabled="{Binding CanChangeAutoConnect}" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="默认外拨" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding OutgoingRoutes}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedOutgoingRoute, Mode=TwoWay}"
                          MinWidth="140" AutomationProperties.Name="默认外拨线路" IsEnabled="{Binding CanChangeWifiPreference}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Margin="0,0,0,14" Padding="18,16" CornerRadius="12" Background="{DynamicResource AppCardBrush}"
                  BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="1">
                <controls:StatusIndicator Item="{Binding WifiStatusIndicator}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VoWifiCurrentEpdg}" TextWrapping="Wrap" Margin="0,8,0,10" FontSize="12"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" AutomationProperties.Name="当前 ePDG 地址" />
                <WrapPanel>
                  <ui:Button Content="{Binding WifiActionText}" Command="{Binding ToggleIndependentVoWifiCommand}" IsEnabled="{Binding CanUseVoWifi}" ToolTip="{Binding WifiActionHint}" Margin="0,0,12,8" />
                  <CheckBox Content="启动时连接 VoWiFi" IsChecked="{Binding AutoConnectVoWifi, Mode=TwoWay}" IsEnabled="{Binding CanChangeWifiPreference}" VerticalAlignment="Center" />
                </WrapPanel>
                <Expander x:Name="VoWifiDiscoveryExpander" Header="高级 · ePDG 发现与回退" IsExpanded="False" Margin="0,10,0,0">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding VoWifiNetworkStack}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" AutomationProperties.Name="VoWiFi 网络协议栈" />
                    <TextBlock Text="{Binding VoWifiDiscoveryIdentitySummary}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Text="域名格式：epdg.epc.mnc{MNC补足3位}.mcc{MCC}.pub.3gppnetwork.org" Margin="0,8,0,0" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel IsEnabled="{Binding CanEditVoWifiDiscovery}">
                      <TextBlock Text="优先尝试的 ePDG（可选）" Margin="0,12,0,5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                      <TextBox Text="{Binding VoWifiPreferredEpdgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True" MinLines="2" MaxLines="4" MaxLength="8192" TextWrapping="Wrap"
                               VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="优先尝试的 ePDG 地址"
                               ToolTip="域名、IPv4 或 IPv6；每行一个，也可用逗号分隔。不填写时自动发现，不含协议或端口。" />
                      <TextBlock Text="留空自动发现；地址不含协议或端口。" Margin="0,5,0,0"
                                 FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                      <TextBlock Text="补充发现 PLMN（可选）" Margin="0,12,0,5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                      <TextBox Text="{Binding VoWifiAdditionalPlmns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               MaxLength="8192" AutomationProperties.Name="补充 ePDG 发现 PLMN"
                               ToolTip="MCC-MNC 或 5 / 6 位数字，多个用空格或逗号分隔；只补充 ePDG 域名，不改 IMSI 或认证 Realm。" />
                      <TextBlock Text="{Binding VoWifiGeneratedEpdgPreview}" Margin="0,6,0,6" FontFamily="Consolas" FontSize="11"
                                 Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.Name="PLMN 生成的 ePDG 地址" />
                      <ui:Button Content="按 PLMN 生成并加入地址" Command="{Binding GenerateVoWifiEpdgCommand}" HorizontalAlignment="Left" />
                      <CheckBox Content="仅使用手动地址，不回退自动发现" Margin="0,12,0,0"
                                IsChecked="{Binding VoWifiManualDiscoveryOnly, Mode=TwoWay}" />
                      <TextBlock Text="按 SIM 保存，下次连接生效。手动地址不能代替 SIM 认证。"
                                 Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                      <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="保存此卡配置" Command="{Binding SaveVoWifiDiscoveryCommand}" Margin="0,0,8,6" />
                        <ui:Button Content="恢复自动发现" Command="{Binding ResetVoWifiDiscoveryCommand}" Appearance="Secondary" Margin="0,0,0,6" />
                      </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding VoWifiDiscoverySettingsMessage}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Grid>
          </Border>

          <Expander Header="运行组件与系统驱动" IsExpanded="False" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="{Binding RuntimeDependencySummary}" TextWrapping="Wrap"
                         Foreground="{DynamicResource AppTextPrimaryBrush}" />
              <TextBlock Margin="0,8,0,0" Text="{Binding RuntimeDriverSummary}" TextWrapping="Wrap"
                         Foreground="{DynamicResource AppTextSecondaryBrush}" />
              <WrapPanel Margin="0,12,0,0">
                <ui:Button Content="安装内置模组驱动" Command="{Binding InstallBundledDriversCommand}"
                           IsEnabled="{Binding CanInstallBundledDrivers}" Margin="0,0,8,0"
                           Visibility="{Binding HasBundledModemDrivers, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="第三方组件与许可证" Command="{Binding OpenRuntimeNoticesCommand}" />
              </WrapPanel>
            </StackPanel>
          </Expander>

          <Expander Header="高级设置 · 蜂窝射频与数据" IsExpanded="False" Margin="0,0,0,14" IsEnabled="{Binding CanEditRadioSettings}">
          <Border
            Margin="0,0,0,14"
            Padding="18,16"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
          >
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="ToggleRight24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                  <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="开关" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding Iccid, Mode=OneWay}" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,5,0" Padding="12,10" Background="{DynamicResource AppInputBrush}" CornerRadius="8">
                  <Grid>
                    <StackPanel Margin="0,0,36,0">
                      <TextBlock FontWeight="SemiBold" Text="通信方式" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="请使用上方工作方式选择器" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Margin="3,0,3,0" Padding="12,10" Background="{DynamicResource AppInputBrush}" CornerRadius="8">
                  <Grid>
                    <StackPanel Margin="0,0,36,0">
                      <TextBlock FontWeight="SemiBold" Text="飞行模式" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="关闭蜂窝射频（CFUN=4）" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding FlightModeSwitchEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding SelectedSlot.SupportsCellularControls}"
                                     ToolTip="仅蜂窝模组支持；PC/SC 读卡器没有蜂窝射频" />
                  </Grid>
                </Border>

                <Border Grid.Column="2" Margin="3,0,3,0" Padding="12,10" Background="{DynamicResource AppInputBrush}" CornerRadius="8">
                  <Grid>
                    <StackPanel Margin="0,0,36,0">
                      <TextBlock FontWeight="SemiBold" Text="蜂窝数据" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="控制 PS 域移动数据附着" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding CellularDataSwitchEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding SelectedSlot.SupportsCellularControls}"
                                     ToolTip="仅蜂窝模组支持；PC/SC 读卡器没有蜂窝射频" />
                  </Grid>
                </Border>

                <Border Grid.Column="3" Margin="5,0,0,0" Padding="12,10" Background="{DynamicResource AppInputBrush}" CornerRadius="8">
                  <Grid>
                    <StackPanel Margin="0,0,36,0">
                      <TextBlock FontWeight="SemiBold" Text="数据漫游" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="允许漫游网络使用数据" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding DataRoamingSwitchEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding SelectedSlot.SupportsCellularControls}"
                                     ToolTip="仅蜂窝模组支持；PC/SC 读卡器没有蜂窝射频" />
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ================= CARD 2: 蜂窝网络 (Cellular Network & SIM Card) ================= -->
          </Expander>
          <Border
            Margin="0,0,0,14"
            Padding="18,16"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
          >
            <StackPanel>
              <!-- Module Header -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="CellularData124" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="蜂窝网络与 SIM" />
                </StackPanel>

                <!-- Header Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- The modem-reported carrier and the IMSI home PLMN are shown separately. -->
                  <Border Margin="0,0,6,0" Padding="8,3" Background="{DynamicResource AppInputBrush}" CornerRadius="6">
                    <TextBlock FontSize="11" FontWeight="SemiBold" ToolTip="归属网络按 IMSI 的 MCC/PLMN 识别。ICCID 只用于识别同一张卡并读取其专属偏好，不能单独判断零售归属地。">
                      <Run Text="IMSI 归属：" />
                      <Run Text="{Binding ImsiHomeDisplay, Mode=OneWay}" />
                    </TextBlock>
                  </Border>
                  <!-- Roaming Badge -->
                  <Border Margin="0,0,6,0" Padding="8,3" Background="{DynamicResource AppInputBrush}" CornerRadius="6">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Text="{Binding RoamingText, Mode=OneWay}" />
                  </Border>
                  <!-- SIM Ready Badge -->
                  <Border Padding="8,3" Background="{DynamicResource AppInputBrush}" CornerRadius="6">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Text="{Binding SimCardStatusText, Mode=OneWay}" />
                  </Border>
                </StackPanel>
              </Grid>

              <!-- 4 Core Metrics (Clean Typography, Natural Whitespace, High SNR) -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. RSSI -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="信号强度 (RSSI)" />
                  <TextBlock FontSize="16" FontWeight="Bold" Margin="0,3,0,0" Text="{Binding SignalDbmText, Mode=OneWay}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0">
                    <Run Text="{Binding SignalEvaluation, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding SignalBars, Mode=OneWay}" /><Run Text="/5格" />
                  </TextBlock>
                </StackPanel>

                <!-- 2. RAT -->
                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="接入制式 (RAT)" />
                  <TextBlock FontSize="16" FontWeight="Bold" Margin="0,3,0,0" Text="{Binding Rat, Mode=OneWay}" />
                </StackPanel>

                <!-- 3. Carrier text reported by the SIM/modem -->
                <StackPanel Grid.Column="2" Margin="4,0,8,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="SIM 报告运营商（CSPN）" />
                  <TextBlock FontSize="15" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding OperatorName, Mode=OneWay}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="IMSI 认证归属：" /><Run Text="{Binding ImsiHomeDisplay, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>

                <!-- 4. Subscriber phone number -->
                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="本机号码 (MSISDN)" />
                  <TextBlock FontSize="15" FontFamily="Consolas" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding PhoneNumber, Mode=OneWay}" ToolTip="{Binding PhoneNumber, Mode=OneWay}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding PhoneNumberDetail, Mode=OneWay}" ToolTip="{Binding PhoneNumberDetail, Mode=OneWay}" />
                </StackPanel>
              </Grid>

              <!-- Exact VoWiFi egress decision. Its source is shown so a multi-IMSI
                   card's retail country is never confused with the country rule. -->
              <Border Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource AppInputBrush}" CornerRadius="8"
                      Visibility="{Binding IsVoWifiMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Grid.Column="0" Symbol="Globe24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="VoWiFi 分流（启动时实际优先级）" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,2,0,0" Text="{Binding VoWifiRoutingRule, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VoWifiRoutingRule, Mode=OneWay}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource AppAccentBrush}" Margin="0,1,0,0" Text="{Binding VoWifiRoutingTarget, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VoWifiRoutingTarget, Mode=OneWay}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" Text="{Binding VoWifiRoutingDetail, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,0,0,3" Text="当前 SIM 的 ICCID 覆盖" />
                    <ComboBox
                      ItemsSource="{Binding HomeRouteOptions}"
                      SelectedItem="{Binding SelectedHomeRouteOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="DisplayName"
                      Padding="8,5"
                      ToolTip="选择后立即保存；跟随 PLMN 会删除该 ICCID 的最高优先级规则"
                    />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Toggle Button for Collapsible Device Details -->
              <Grid Margin="0,4,0,0">
                <ui:Button
                  HorizontalAlignment="Left"
                  Appearance="Transparent"
                  Padding="4,2"
                  Command="{Binding ToggleDeviceDetailsCommand}"
                  Content="{Binding DeviceDetailsToggleText, Mode=OneWay}"
                  Foreground="{DynamicResource AppAccentBrush}"
                  FontSize="12"
                />
              </Grid>

              <!-- Collapsible Device Details Matrix (6 Low-Frequency Diagnostic Parameters) -->
              <Border
                Margin="0,8,0,0"
                Padding="12,10"
                Background="{DynamicResource AppInputBrush}"
                CornerRadius="8"
                Visibility="{Binding IsDeviceDetailsExpanded, Converter={StaticResource BoolToVis}}"
              >
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- Row 0: ICCID, IMSI, IMEI -->
                  <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="SIM 识别码 (ICCID) · 用于识别卡片与读取偏好" />
                    <TextBlock FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Iccid, Mode=OneWay}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppAccentBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                      <Run Text="卡片别名：" /><Run Text="{Binding CardNicknameDisplay, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>

                  <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,8,8">
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="国际移动用户识别码 (IMSI) · 认证归属" />
                    <TextBlock FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Imsi, Mode=OneWay}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding ImsiHomeDisplay, Mode=OneWay}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding ImsiSourceDisplay, Mode=OneWay}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding ImsiSourcesDisplay, Mode=OneWay}" ToolTip="{Binding ImsiSourcesDisplay, Mode=OneWay}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppWarningBrush}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding ImsiStabilityDisplay, Mode=OneWay}" ToolTip="{Binding ImsiStabilityDisplay, Mode=OneWay}" />
                  </StackPanel>

                  <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,0,8">
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="设备识别码 (IMEI)" />
                    <TextBlock FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Imei, Mode=OneWay}" />
                  </StackPanel>

                  <!-- Row 1: Cell ID, Modem HW, Firmware -->
                  <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="服务小区 (Cell ID)" />
                    <TextBlock FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding CellIdText, Mode=OneWay}" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="模组型号与波特率" />
                    <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding BaudRateText, Mode=OneWay}" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="基带固件版本" />
                    <TextBlock FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding ModemFirmware, Mode=OneWay}" />
                  </StackPanel>
                </Grid>
              </Border>

            </StackPanel>
          </Border>

          <!-- ================= CARD 3: 蜂窝 Host IMS 数据面 ================= -->
        </StackPanel>
      </ScrollViewer>

      <!-- ================= RIGHT COLUMN: Collapsible Structured Real-Time Event Log ================= -->
      <!-- 1. Expanded Panel (Default ~360px) -->
      <Border
        x:Name="ExpandedTerminalPanel"
        Grid.Column="1"
        Width="370"
        Padding="14,12"
        Background="{DynamicResource AppCardBrush}"
        BorderBrush="{DynamicResource AppCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="12"
        PreviewMouseWheel="OnTerminalPreviewMouseWheel"
        Visibility="{Binding IsLogPanelExpanded, Converter={StaticResource BoolToVis}}"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Terminal Header: Title + Fold button + Counter + Action icons -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Count -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Code24" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" FontSize="16" />
              <TextBlock FontSize="14" FontWeight="SemiBold" Text="日志与诊断" VerticalAlignment="Center" />
              <Border Margin="6,0,0,0" Padding="6,2" Background="{DynamicResource AppInputBrush}" CornerRadius="4">
                <TextBlock FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding FilteredLogsCountText, Mode=OneWay}" />
              </Border>
            </StackPanel>

            <!-- Actions: AutoScroll toggle, Copy, Clear, Collapse -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- AutoScroll status toggle -->
              <ui:Button
                Appearance="Transparent"
                Padding="6,2"
                Margin="0,0,4,0"
                Command="{Binding ToggleAutoScrollCommand}"
                ToolTip="切换自动滚动状态 (跟随最新 / 暂停跟随)"
              >
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="{Binding AutoScrollStatusIcon, Mode=OneWay}" FontSize="12" Margin="0,0,3,0" />
                  <TextBlock FontSize="11" Text="{Binding AutoScrollStatusText, Mode=OneWay}" />
                </StackPanel>
              </ui:Button>

              <!-- Copy button -->
              <ui:Button
                Appearance="Transparent"
                Padding="6,2"
                Margin="0,0,2,0"
                Command="{Binding CopyLogsCommand}"
                Icon="{ui:SymbolIcon Symbol=Copy24}"
                ToolTip="复制全部日志"
              />

              <!-- Clear button -->
              <ui:Button
                Appearance="Transparent"
                Padding="6,2"
                Margin="0,0,2,0"
                Command="{Binding ClearLogsCommand}"
                Icon="{ui:SymbolIcon Symbol=Delete24}"
                ToolTip="清空实时日志"
              />

              <!-- Collapse panel button -->
              <ui:Button
                Appearance="Transparent"
                Padding="6,2"
                Command="{Binding ToggleLogPanelCommand}"
                Icon="{ui:SymbolIcon Symbol=ChevronRight24}"
                ToolTip="收起实时日志面板"
              />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <DockPanel>
              <ui:Button DockPanel.Dock="Right" Content="{Binding DiagnosticExportButtonText}"
                         Command="{Binding ExportImsDiagnosticsCommand}" Padding="10,4"
                         ToolTip="导出脱敏 ZIP；保留网络 IP / 域名" />
              <CheckBox Content="记录详细日志" IsChecked="{Binding DetailedDiagnosticsEnabled, Mode=TwoWay}"
                        IsEnabled="{Binding CanChangeDiagnosticSetting}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding DiagnosticRecordingStatus}" FontSize="11" Margin="0,5,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            <TextBlock Text="{Binding DiagnosticExportStatus}" FontSize="11" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DiagnosticExportStatus}" />
          </StackPanel>

          <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource AppTextPrimaryBrush}">
            <TabItem Header="日志">
              <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
              <ui:Button
                Content="全部"
                Command="{Binding SetLogModuleCommand}"
                CommandParameter="全部"
              >
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource LogFilterButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFilterAll, Mode=OneWay}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>

              <ui:Button
                Content="Modem"
                Command="{Binding SetLogModuleCommand}"
                CommandParameter="Modem"
              >
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource LogFilterButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFilterModem, Mode=OneWay}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>

              <ui:Button
                Content="VoWiFi"
                Command="{Binding SetLogModuleCommand}"
                CommandParameter="VoWiFi"
              >
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource LogFilterButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFilterVoWifi, Mode=OneWay}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>

              <ui:Button
                Content="IMS"
                Command="{Binding SetLogModuleCommand}"
                CommandParameter="IMS"
              >
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource LogFilterButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFilterIms, Mode=OneWay}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>

              <ui:Button
                Content="SIP"
                Command="{Binding SetLogModuleCommand}"
                CommandParameter="SIP"
              >
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource LogFilterButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFilterSip, Mode=OneWay}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>
            </StackPanel>
          </Grid>

          <!-- Search Input Box -->
          <ui:TextBox
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="8,3"
            FontSize="11"
            PlaceholderText="搜索日志内容..."
            Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ClearButtonEnabled="True"
          />

          <!-- Structured Log List with Fixed Columns (Time / Level / Module / Message) -->
          <Border
            Grid.Row="2"
            Background="{DynamicResource AppInputBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6,6,4,6"
          >
            <ListBox
              x:Name="LogList"
              ItemsSource="{Binding FilteredLogs}"
              Background="Transparent"
              BorderThickness="0"
              ScrollViewer.VerticalScrollBarVisibility="Visible"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.CanContentScroll="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Pixel"
              Focusable="False"
            >
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,0,4" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Focusable" Value="False" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,1,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="42" />
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. Fixed Time (HH:mm:ss) -->
                    <TextBlock
                      Grid.Column="0"
                      FontFamily="Consolas"
                      FontSize="10"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource AppTextTertiaryBrush}"
                      Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}"
                    />

                    <!-- 2. Fixed Level Badge (INFO/WARN/ERROR/DEBUG with Token Colors) -->
                    <Border
                      Grid.Column="1"
                      Margin="2,0,4,0"
                      Padding="3,1"
                      CornerRadius="4"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{Binding LevelBackground, Mode=OneWay}"
                    >
                      <TextBlock
                        FontFamily="Consolas"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="{Binding LevelColor, Mode=OneWay}"
                        Text="{Binding Level, Mode=OneWay}"
                      />
                    </Border>

                    <!-- 3. Fixed Module Source -->
                    <Border
                      Grid.Column="2"
                      Margin="0,0,4,0"
                      Padding="3,1"
                      CornerRadius="4"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{DynamicResource AppCardBrush}"
                    >
                      <TextBlock
                        FontFamily="Consolas"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                        Text="{Binding Source, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </Border>

                    <!-- 4. Log Message -->
                    <TextBlock
                      Grid.Column="3"
                      FontFamily="Consolas"
                      FontSize="11"
                      LineHeight="16"
                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                      Text="{Binding Message, Mode=OneWay}"
                      TextWrapping="Wrap"
                      VerticalAlignment="Center"
                    />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
              </Grid>
            </TabItem>
            <TabItem Header="连接详情" x:Name="ConnectionDetailsTab">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,10">
                    <Run Text="控制端口：" /><Run Text="{Binding SelectedSlot.PortName, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding TelephonyDetail}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
                  <StackPanel>
                    <TextBlock Text="{Binding MainStatusTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Stage1Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Stage2Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Stage3Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Stage4Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="隧道地址 / P-CSCF" FontSize="11" Margin="0,14,0,4" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Text="{Binding AssignedIp}" FontFamily="Consolas" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PcscfIp}" FontFamily="Consolas" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource AppDangerBrush}" />
                    <TextBlock Text="SIP 保活" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBlock Text="{Binding SipProbeRtt}" />
                    <TextBlock Text="{Binding SipProbeCountText}" FontSize="12" />
                    <TextBlock Text="{Binding LastProbeStatusText}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NatBindingText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ui:Button Content="探测 SIP" Command="{Binding SendSipProbeCommand}" IsEnabled="{Binding Stage3Success}"
                               HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="发送 SIP OPTIONS，测试往返延迟" />
                  </StackPanel>
                  <StackPanel Visibility="{Binding IsHostImsMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding HostImsRegistrationStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HostImsPppStatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding HostImsMediaStatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="本机地址 / P-CSCF" FontSize="11" Margin="0,14,0,4" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Text="{Binding HostImsPdnAddress}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HostImsPcscf}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HostImsWindowsInterface}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="模组数据面" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBlock Text="{Binding HostImsStatusTitle}" FontSize="12" />
                    <TextBlock Text="{Binding HostImsStatusDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HostImsContextText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ui:Button Content="探测数据面" Command="{Binding ProbeHostImsCommand}" HorizontalAlignment="Left"
                               Margin="0,8,0,0" ToolTip="读取模组状态；不修改 APN、不激活 PDP" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <!-- 2. Collapsed Vertical Strip (When user collapses log panel, shows slim icon bar to restore) -->
      <Border
        x:Name="CollapsedTerminalStrip"
        Grid.Column="1"
        Width="36"
        Margin="4,0,0,0"
        Background="{DynamicResource AppCardBrush}"
        BorderBrush="{DynamicResource AppCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Visibility="{Binding IsLogPanelExpanded, Converter={StaticResource InvertBoolToVis}}"
      >
        <ui:Button
          Appearance="Transparent"
          Padding="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Command="{Binding ToggleLogPanelCommand}"
          ToolTip="展开日志与诊断"
        >
          <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,10" />
            <ui:SymbolIcon Symbol="Code24" FontSize="16" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,10" />
            <TextBlock
              Text="日志与诊断"
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AppTextSecondaryBrush}"
              HorizontalAlignment="Center"
            >
              <TextBlock.LayoutTransform>
                <RotateTransform Angle="90" />
              </TextBlock.LayoutTransform>
            </TextBlock>
          </StackPanel>
        </ui:Button>
      </Border>

    </Grid>
  </Grid>
</Page>
