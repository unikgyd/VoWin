<Page
  x:Class="VoWin.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:local="clr-namespace:VoWin.Views.Pages"
  xmlns:controls="clr-namespace:VoWin.Views.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="系统设置"
  d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="750"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource AppTextPrimaryBrush}"
  Foreground="{DynamicResource AppTextPrimaryBrush}"
  Background="{DynamicResource AppSurfaceBrush}"
  PreviewMouseWheel="OnPagePreviewMouseWheel"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <DataTemplate x:Key="SipPolicyEditorTemplate">
      <StackPanel>
        <WrapPanel>
          <CheckBox Content="内部分机通话" IsChecked="{Binding AllowInternalCalls}" Margin="0,0,16,8"/>
          <CheckBox Content="内部分机消息" IsChecked="{Binding AllowMessages}" Margin="0,0,0,8"/>
        </WrapPanel>
        <WrapPanel>
          <CheckBox Content="经 SIM 外拨" IsChecked="{Binding AllowCalls}" Margin="0,0,16,8"/>
          <CheckBox Content="经 SIM 发短信" IsChecked="{Binding AllowSms}" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock Text="允许外拨的线路 ID" Margin="0,0,0,6"/>
        <TextBox Text="{Binding OutgoingLines, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="允许发短信的线路 ID" Margin="0,8,0,6"/>
        <TextBox Text="{Binding SmsSendLines, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="逗号分隔；* 不限制线路，留空禁止。仍受全局与模组开关限制。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,8"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="ThemeChoiceStyle" TargetType="RadioButton">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="ChoiceCard"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" />
                <Grid Grid.Column="1" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Ellipse x:Name="ChoiceRing" Stroke="{DynamicResource AppCardBorderBrush}" StrokeThickness="1.5" />
                  <Ellipse x:Name="ChoiceDot" Width="8" Height="8" Fill="{DynamicResource AppAccentBrush}" Opacity="0" />
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChoiceCard" Property="Background" Value="{DynamicResource AppHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ChoiceCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ChoiceCard" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                <Setter TargetName="ChoiceCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="ChoiceRing" Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="ChoiceDot" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ChoiceCard" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="24,18,24,24" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent">
      <StackPanel>
        <TextBlock Style="{DynamicResource AppPageTitleStyle}" Text="设置" />
      </StackPanel>
    </Grid>

    <ScrollViewer
      x:Name="SettingsScrollViewer"
      Grid.Row="1"
      Background="Transparent"
      HorizontalContentAlignment="Stretch"
      VerticalScrollBarVisibility="Auto"
    >
      <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Background="Transparent">
        
        <!-- Section 1: Personalization -->
        <Border
          Margin="0,0,0,16"
          Padding="16,14"
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
        >
          <StackPanel>
            <TextBlock Style="{DynamicResource AppSectionTitleStyle}" Text="界面与个性化" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <RadioButton
                  Grid.Column="0"
                  Style="{StaticResource ThemeChoiceStyle}"
                  Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                  CommandParameter="theme_light"
                  GroupName="themeSelect"
                  IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="20" Margin="0,0,10,0" Foreground="{DynamicResource AppWarningBrush}" />
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="浅色主题" />
                    </StackPanel>
                  </StackPanel>
              </RadioButton>
              <RadioButton
                  Grid.Column="2"
                  Style="{StaticResource ThemeChoiceStyle}"
                  Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                  CommandParameter="theme_dark"
                  GroupName="themeSelect"
                  IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="20" Margin="0,0,10,0" Foreground="{DynamicResource AppAccentBrush}" />
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="深色主题" />
                    </StackPanel>
                  </StackPanel>
              </RadioButton>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="SmsApiCard" Margin="0,0,0,16" Padding="16,14" Background="{DynamicResource AppCardBrush}"
                BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <controls:StatusIndicator DockPanel.Dock="Right" Item="{Binding ViewModel.SmsApiIndicator}" />
              <TextBlock Style="{DynamicResource AppSectionTitleStyle}" Text="短信与验证码 API" />
            </DockPanel>
            <StackPanel IsEnabled="{Binding ViewModel.CanEditSmsApi}">
              <ui:ToggleSwitch Content="启用只读短信 API（启动时恢复）" IsChecked="{Binding ViewModel.SmsApiEnabled}" Margin="0,0,0,10" />
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="监听 IP（默认仅本机）" Margin="0,0,0,6" /><TextBox Text="{Binding ViewModel.SmsApiBindAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="短信 API 监听 IP" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="端口" Margin="0,0,0,6" /><ui:NumberBox Value="{Binding ViewModel.SmsApiPort, Mode=TwoWay}" Minimum="1024" Maximum="65535" AutomationProperties.Name="短信 API 端口" /></StackPanel>
              </Grid>
              <CheckBox Content="允许局域网／VPN 访问（须填写具体内网 IP）" IsChecked="{Binding ViewModel.SmsApiAllowLanAccess}" Margin="0,0,0,10" />
              <TextBlock Text="Token（持有者可查询所有线路的最近收件短信与验证码）" TextWrapping="Wrap" Margin="0,0,0,6" />
              <ui:PasswordBox Password="{Binding ViewModel.SmsApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="短信 API Token" />
              <WrapPanel Margin="0,10,0,10">
                <ui:Button Content="生成新 Token" Command="{Binding ViewModel.GenerateSmsApiTokenCommand}" Margin="0,0,10,6" />
                <ui:Button Content="保存并应用 API" Command="{Binding ViewModel.SaveSmsApiCommand}" Appearance="Primary" Margin="0,0,0,6" />
              </WrapPanel>
            </StackPanel>
            <TextBlock Text="Token 加密保存在当前 Windows 用户下。HTTP 仅用于本机／可信私网；公网请使用 HTTPS 反向代理，勿直接映射此端口。不自动放行防火墙。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            <TextBlock Text="{Binding ViewModel.SmsApiNotice}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
            <Expander Header="接口地址与用法" Margin="0,10,0,0" IsExpanded="False">
              <StackPanel Margin="0,10,0,0">
                <TextBox Text="{Binding ViewModel.SmsApiEndpoint, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10" />
                <TextBlock Text="{Binding ViewModel.SmsApiHelp}" TextWrapping="Wrap" FontSize="12" LineHeight="21" />
                <TextBlock Text="{Binding ViewModel.SmsApiIndicator.Detail}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <!-- Section 2: Telephony Preferences -->
        <Border
          Margin="0,0,0,16"
          Padding="16,14"
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
        >
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="设备与启动" />

            <TextBlock Text="设备控制" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding ViewModel.ControlPreferences}" SelectedValuePath="Value" DisplayMemberPath="Title"
                      SelectedValue="{Binding ViewModel.SelectedControlPreference, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="180" />
            <TextBlock Text="QMI 不可用时回退 AT；已连接会话保持不变。" Margin="0,6,0,16" FontSize="12"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" />

            <ui:ToggleSwitch
              Margin="0,0,0,16"
              IsChecked="{Binding ViewModel.AutoConnectKnownModem}"
              Content="启动及插入 USB 时自动检测通信设备"
            />
            <ui:Button HorizontalAlignment="Left" Appearance="Primary" Content="保存设备设置" Command="{Binding ViewModel.SaveStartupSettingsCommand}" />
            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel.TelephonySettingsStatus}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Margin="0,0,0,16" Padding="16,14" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="通话音频与自动接听" />
            <ui:ToggleSwitch Margin="0,0,0,8" IsChecked="{Binding ViewModel.VolteAudioPrewarmEnabled}" Content="启用 VoLTE 音频预热" />
            <Border Margin="0,0,0,18" Padding="12,9" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="8">
              <TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" Text="预热会持续占用麦克风；关闭后仅在通话时启用。" />
            </Border>
            <ui:ToggleSwitch Margin="0,0,0,8" IsChecked="{Binding ViewModel.SaveCallRecordings}" Content="保存 Windows IMS 通话录音（Host IMS / VoWiFi）" />
            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="最多保留最近 20 通。" TextWrapping="Wrap" />
            <TextBlock Text="录音保存文件夹" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,16">
              <ui:Button DockPanel.Dock="Right" Content="选择文件夹" Command="{Binding ViewModel.BrowseRecordingDirectoryCommand}" />
              <TextBox Margin="0,0,12,0" Text="{Binding ViewModel.RecordingDirectory, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding ViewModel.AutoAnswerEnabled}" Content="超时无人接听时自动接听并播放录音" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <TextBlock VerticalAlignment="Center" Text="等待秒数" Margin="0,0,12,0" />
              <TextBox Width="80" Text="{Binding ViewModel.AutoAnswerDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock Text="接听后播放的录音文件" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,12">
              <ui:Button DockPanel.Dock="Right" Content="选择文件" Command="{Binding ViewModel.BrowseAutoAnswerMessageCommand}" />
              <TextBox Margin="0,0,12,0" Text="{Binding ViewModel.AutoAnswerMessagePath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"
                       Text="录音发送给来电方，播完恢复麦克风；文件不可用时不会自动接听。" />
            <ui:Button HorizontalAlignment="Left" Appearance="Primary" Content="保存通话设置" Command="{Binding ViewModel.SaveCallSettingsCommand}" />
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ViewModel.CallSettingsStatus}" />
          </StackPanel>
        </Border>

        <Border x:Name="SipGatewayCard" Margin="0,0,0,16" Padding="16,14" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="SIP 对接 · 可选" />
            <TextBlock Margin="0,4,0,14" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Text="本机与分机共同响铃，首接通话；本机拒接会结束整通来电。" />
            <Border Margin="0,0,0,14" Padding="12,9" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" Text="仅用于局域网 / VPN，SIP UDP 与 RTP 未加密，请勿暴露公网。记住配置时密码由当前 Windows 用户加密保护；关闭对接会结束经 SIP 转接的通话。" />
            </Border>
            <StackPanel x:Name="SipConfigurationPanel" IsEnabled="{Binding ViewModel.CanEditSipGateway}">
            <ui:ToggleSwitch x:Name="SipTrunkModeSwitch" Margin="0,0,0,6" IsChecked="{Binding ViewModel.SipGatewayUseTrunk}" Content="使用 SIP 服务器中继（Asterisk 等）" />
            <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Text="中继与本地分机可同时启用，也可只使用其中一种。中继不向服务器注册。" />
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,6" Text="本机监听 IP（局域网 / VPN）" />
                <TextBox Text="{Binding ViewModel.SipGatewayBindAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="电脑已分配的 IP，例如 192.168.1.20 或 10.66.66.1，不能填写服务器 IP" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,6" Text="SIP UDP 端口" />
                <TextBox Text="{Binding ViewModel.SipGatewayPort, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <StackPanel x:Name="SipTrunkPanel" Visibility="{Binding ViewModel.SipTrunkVisibility}">
                <WrapPanel Margin="0,0,0,10">
                  <ui:Button Content="导入 Asterisk 部署配置" Command="{Binding ViewModel.ImportSipDeploymentCommand}" Margin="0,0,8,6" />
                  <ui:Button Content="自动选择本机网卡地址" Command="{Binding ViewModel.DetectSipBindAddressCommand}" Margin="0,0,0,6" />
                </WrapPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Margin="0,0,0,6" Text="SIP 服务器 IP" /><TextBox Text="{Binding ViewModel.SipGatewayServerAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 Asterisk 的 VPN IP；暂不使用域名" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,6" Text="服务器 UDP 端口" /><TextBox Text="{Binding ViewModel.SipGatewayServerPort, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Margin="0,0,0,6" Text="入站账号（服务器 → VoWin）" /><TextBox Text="{Binding ViewModel.SipGatewayTrunkUsername, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,6" Text="来电转接目标 / 振铃组" /><TextBox Text="{Binding ViewModel.SipGatewayIncomingTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 600；由 Asterisk 拨号计划定义" /></StackPanel>
              </Grid>
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="入站独立密码" Margin="0,0,0,6"/><ui:PasswordBox Password="{Binding ViewModel.SipPeerInboundPassword, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="入站摘要算法" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding ViewModel.SipPeerInboundAlgorithms}" SelectedItem="{Binding ViewModel.SipPeerInboundAlgorithm}"/></StackPanel>
              </Grid>
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="出站账号（VoWin → 服务器）" Margin="0,0,0,6"/><TextBox Text="{Binding ViewModel.SipPeerOutboundUsername, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="出站独立密码" Margin="0,0,0,6"/><ui:PasswordBox Password="{Binding ViewModel.SipPeerOutboundPassword, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              </Grid>
              <TextBlock Text="服务器预期 Realm（精确匹配）" Margin="0,0,0,6"/>
              <TextBox Text="{Binding ViewModel.SipPeerExpectedRealm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="填写服务器实际挑战 Realm；修改后需重新填写出站密码。不自动学习，不允许 *。"/>
              <WrapPanel>
                <CheckBox Content="出站 SHA-256" IsChecked="{Binding ViewModel.SipPeerAllowSha256}" Margin="0,0,16,8"/>
                <CheckBox Content="出站 MD5（兼容模式）" IsChecked="{Binding ViewModel.SipPeerAllowMd5}" Margin="0,0,0,8"/>
              </WrapPanel>
              <Expander Header="中继权限与线路" Margin="0,0,0,8">
                <StackPanel Margin="0,10,0,0">
                  <WrapPanel>
                    <CheckBox Content="PBX → SIM 通话" IsThreeState="True" IsChecked="{Binding ViewModel.SipPeerAllowOutboundCalls}" Margin="0,0,16,8"/>
                    <CheckBox Content="PBX → SIM 短信" IsThreeState="True" IsChecked="{Binding ViewModel.SipPeerAllowOutboundMessages}" Margin="0,0,0,8"/>
                  </WrapPanel>
                  <WrapPanel>
                    <CheckBox Content="SIM → PBX 来电" IsThreeState="True" IsChecked="{Binding ViewModel.SipPeerAllowIncomingCalls}" Margin="0,0,16,8"/>
                    <CheckBox Content="SIM → PBX 短信" IsThreeState="True" IsChecked="{Binding ViewModel.SipPeerAllowIncomingMessages}" Margin="0,0,0,8"/>
                  </WrapPanel>
                  <TextBlock Text="灰色沿用旧设置：出站跟随总开关，入站允许。" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <TextBlock Text="允许外拨的线路 ID" Margin="0,0,0,6"/>
                  <TextBox Text="{Binding ViewModel.SipPeerOutgoingLines, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="允许发短信的线路 ID" Margin="0,8,0,6"/>
                  <TextBox Text="{Binding ViewModel.SipPeerSmsSendLines, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="逗号分隔；* 不限制，留空禁止。权限不会从同名本地分机继承。" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Expander>
              <ui:Button Content="重置中继接收身份" Command="{Binding ViewModel.ResetSipPeerRecipientIdentityCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="密码不变也可重置；保存后旧身份的待投短信不再转发。"/>
              <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Text="默认 SHA-256。双向账号和密码独立；入站还要求服务器 IP 与源端口匹配。旧共享密码不会自动复用。已配置不代表服务器可达或通话通过。" />
            </StackPanel>
            <ui:ToggleSwitch Content="启用本地分机服务（软电话直接注册 VoWin）" IsChecked="{Binding ViewModel.SipLocalRegistrarEnabled}" Margin="0,0,0,10"/>
            <StackPanel Margin="0,0,0,14" Visibility="{Binding ViewModel.SipLocalVisibility}">
              <StackPanel Margin="0,0,0,10">
                <TextBlock Margin="0,0,0,6" Text="分机号" />
                <TextBox Text="{Binding ViewModel.SipGatewayExtension, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Margin="0,0,0,6" Text="主分机独立密码" />
                <ui:PasswordBox Password="{Binding ViewModel.SipGatewayPassword, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Content="重置分机接收身份" Command="{Binding ViewModel.ResetSipMainRecipientIdentityCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="相同密码重设时也请重置；保存后旧身份的待投短信不再转发，密码保持不变。"/>
                <Expander Header="主分机权限与线路" Margin="0,10,0,0">
                  <StackPanel Margin="0,10,0,0">
                    <ContentControl Content="{Binding ViewModel.SipPrimaryPolicy}" ContentTemplate="{StaticResource SipPolicyEditorTemplate}"/>
                    <TextBlock Text="主分机默认线路" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ViewModel.SipOutboundLineChoices}" DisplayMemberPath="AccountLabel" SelectedValuePath="SlotId" SelectedValue="{Binding ViewModel.SipPrimaryPolicy.DefaultLineId}"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
            <TextBlock Margin="0,0,0,6" Text="VoWin 认证 Realm" />
            <TextBox Margin="0,0,0,14" Text="{Binding ViewModel.SipGatewayRealm, UpdateSourceTrigger=PropertyChanged}" ToolTip="本地分机与中继入站使用的认证 Realm；不是运营商 IMS Realm，也不是服务器出站预期 Realm。修改后需重新填写中继入站密码。" />
            <Expander Header="来源限制与身份域" Margin="0,0,0,14">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="允许连接的私网 CIDR" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ViewModel.SipTrustedNetworks, UpdateSourceTrigger=PropertyChanged}" ToolTip="逗号分隔，同监听地址协议栈；留空拒绝全部。* 仅保留旧版不限来源模式，不代表公网服务。"/>
                <TextBlock Text="身份展示与回复域" Margin="0,10,0,6"/>
                <TextBox Text="{Binding ViewModel.SipIdentityDomain, UpdateSourceTrigger=PropertyChanged}" ToolTip="软电话可访问的 SIP 域或私网 IP；留空沿用认证 Realm，不会改变认证 Realm 或服务器端点。"/>
                <TextBlock Text="本地分机认证算法" Margin="0,10,0,6"/>
                <ComboBox ItemsSource="{Binding ViewModel.SipPeerInboundAlgorithms}" SelectedItem="{Binding ViewModel.SipLocalRegistrarAlgorithm}"/>
                <TextBlock Text="SHA-256 优先用于新部署；MD5 仅兼容旧终端。来源限制在任何 SIP 回复前生效。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
              </StackPanel>
            </Expander>
            <ui:ToggleSwitch Margin="0,0,0,14" IsChecked="{Binding ViewModel.SipGatewayAllowOutboundCalls}" Content="允许经 SIM 外拨（可能产生费用）" />
            <Expander Header="本地分机 · 附加账号" Visibility="{Binding ViewModel.SipLocalVisibility}" Margin="0,0,0,14">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="VoWin 可独立注册多台分机，支持互拨、群振和文本消息，不必部署 Asterisk；分机互拨不经过 SIM。上方账号为主分机，下方可添加独立账号。仅支持私网 / VPN 的 UDP SIP 与 G.711，不提供公网注册或手机后台推送。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ViewModel.SipExtensions}" AutomationProperties.Name="SIP 附加分机">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8">
                        <StackPanel>
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="分机账号" Margin="0,0,0,6"/><TextBox MaxLength="64" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="独立密码" Margin="0,0,0,6"/><ui:PasswordBox Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                          </Grid>
                          <Expander Header="分机权限与线路" Margin="0,10,0,8">
                            <ContentControl Margin="0,10,0,0" Content="{Binding}" ContentTemplate="{StaticResource SipPolicyEditorTemplate}"/>
                          </Expander>
                          <TextBlock Text="该分机默认线路（也可沿用全局 / 号码规则）" TextWrapping="Wrap" Margin="0,0,0,6"/>
                          <ComboBox ItemsSource="{Binding DataContext.ViewModel.SipOutboundLineChoices, RelativeSource={RelativeSource AncestorType=Page}}" DisplayMemberPath="AccountLabel" SelectedValuePath="SlotId" SelectedValue="{Binding DefaultLineId}"/>
                          <WrapPanel Margin="0,10,0,0">
                            <ui:Button Content="重置接收身份" Margin="0,0,8,0" Command="{Binding DataContext.ViewModel.ResetSipExtensionRecipientIdentityCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" ToolTip="密码不变也可重置；保存后旧身份的待投短信不再转发。"/>
                            <ui:Button Content="移除分机" Command="{Binding DataContext.ViewModel.RemoveSipExtensionCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="添加分机" HorizontalAlignment="Left" Command="{Binding ViewModel.AddSipExtensionCommand}"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="文本消息 · SIP MESSAGE" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ui:ToggleSwitch Content="启用 SIP 文本消息" IsChecked="{Binding ViewModel.SipMessagesEnabled}" Margin="0,0,0,8"/>
            <StackPanel IsEnabled="{Binding ViewModel.SipMessagesEnabled}">
              <WrapPanel><CheckBox Content="收到 SIM 短信时转发到 SIP" IsChecked="{Binding ViewModel.SipForwardIncomingSms}" Margin="0,0,16,8"/><CheckBox Content="允许 SIP 经 SIM 发短信（可能收费）" IsChecked="{Binding ViewModel.SipAllowOutgoingSms}" Margin="0,0,0,8"/></WrapPanel>
            </StackPanel>
            <TextBlock Text="短信还需开启模组权限。转发会向指定终端发送验证码等敏感内容；提交成功不等于送达。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,14"/>
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="内部 VoIP · 每个模组独立配置" Margin="0,0,0,6" />
            <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"
                       Text="沿用模组的默认呼出；关闭接入不影响模组注册。修改规则需先关闭 SIP。" />
            <ui:Button Content="刷新模组线路" Command="{Binding ViewModel.RefreshSipModuleRoutesCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding ViewModel.SipModuleRoutes}" AutomationProperties.Name="内部 VoIP 模组线路">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                        <CheckBox Grid.Column="1" Content="接入内部 VoIP" IsChecked="{Binding Enabled}" />
                      </Grid>
                      <TextBlock Text="{Binding LineSummary}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                      <TextBlock Text="{Binding ConnectionSummary}" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                      <StackPanel IsEnabled="{Binding Enabled}">
                        <WrapPanel><CheckBox Content="转接来电" IsChecked="{Binding AllowIncomingCalls}" Margin="0,0,18,8" /><CheckBox Content="允许外拨" IsChecked="{Binding AllowOutgoingCalls}" Margin="0,0,0,8" /></WrapPanel>
                        <TextBlock Text="中继来电目标（无中继时兼容本地目标；留空沿用全局）" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <TextBox Text="{Binding IncomingTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 1001、1002 或 Asterisk 振铃组。不会更改服务器拨号计划。" />
                        <TextBlock Text="本地来电分机（留空：有中继时全部；无中继时沿用上方目标，均空才全部）" TextWrapping="Wrap" Margin="0,8,0,6"/>
                        <TextBox Text="{Binding LocalIncomingTarget, UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel Margin="0,10,0,0"><CheckBox Content="转发收到的短信" IsChecked="{Binding ForwardIncomingSms}" Margin="0,0,18,8"/><CheckBox Content="允许发短信" IsChecked="{Binding AllowOutgoingSms}" Margin="0,0,0,8"/></WrapPanel>
                        <TextBlock Text="短信目标（直连留空转发所有在线分机；中继留空沿用全局目标）" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding SmsTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip="与来电目标独立；离线不积压，原短信仍保留在 VoWin。"/>
                        <TextBlock Text="本地短信分机（留空：有中继时全部；无中继时沿用上方目标，均空才全部）" TextWrapping="Wrap" Margin="0,8,0,6"/>
                        <TextBox Text="{Binding LocalSmsTarget, UpdateSourceTrigger=PropertyChanged}"/>
                        <Expander Header="选线前缀与国家号码" Margin="0,10,0,0">
                          <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="选线前缀" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" ToolTip="可选，1–8 位数字。未明确指定线路时按最长前缀选线，选中后删除该前缀。"/>
                            <CheckBox Content="使用严格国际号码（E.164）" IsChecked="{Binding NormalizeE164}" Margin="0,10,0,8"/>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <StackPanel><TextBlock Text="国家码（不含 +）" Margin="0,0,0,6"/><TextBox Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/></StackPanel>
                              <StackPanel Grid.Column="2"><TextBlock Text="本国号码位数（0 = 不补号）" Margin="0,0,0,6"/><TextBox Text="{Binding NationalNumberLength, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </Grid>
                            <TextBlock Text="仅对长度准确匹配的本国号码补国家码；已有 + 的号码不改写，失败不换卡。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                          </StackPanel>
                        </Expander>
                        <Expander Header="独立接收名单与中继转发" Margin="0,10,0,0">
                          <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="本地来电分机名单" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding LocalIncomingExtensions, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="本地短信分机名单" Margin="0,8,0,6"/>
                            <TextBox Text="{Binding LocalSmsRecipients, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="逗号分隔；留空不投递，* 沿用上方旧目标设置。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,8"/>
                            <WrapPanel>
                              <CheckBox Content="来电转给 PBX" IsThreeState="True" IsChecked="{Binding ForwardCallsToPeer}" Margin="0,0,16,8"/>
                              <CheckBox Content="短信转给 PBX" IsThreeState="True" IsChecked="{Binding ForwardSmsToPeer}" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="灰色沿用旧转发。明确启用时，须填写对应中继目标。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="未携带选线头时的默认外拨线路" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding ViewModel.SipOutboundLineChoices}" SelectedItem="{Binding ViewModel.SelectedSipOutboundLine}" DisplayMemberPath="Label" Margin="0,0,0,6" />
            <TextBlock Text="默认要求请求携带 X-VoWin-Line。不会跟随界面切卡或更换 SIM 自动选另一模组；中继外拨还须开启上方服务器外拨总开关。" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <Expander Header="号码规则 · 自定义选线与补号" Margin="0,0,0,14">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="兼容号码规则，按顺序匹配。显式线路 / 分机默认线路优先，然后匹配此处规则，最后匹配模组的最长选线前缀或全局默认；失败不换卡。此处规则同时用于电话和短信，Asterisk 的通话与短信规则独立。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding ViewModel.SipDialRules}" AutomationProperties.Name="SIP 号码规则">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8">
                      <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="匹配前缀" Margin="0,0,0,6"/><TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                          <StackPanel Grid.Column="2"><TextBlock Text="号码总长度（0 = 不限）" Margin="0,0,0,6"/><TextBox Text="{Binding TotalLength, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <CheckBox Content="删除匹配的前缀" IsChecked="{Binding StripPrefix}" Margin="0,10,0,8"/>
                        <TextBlock Text="在号码前补充（可留空，例如 + 或 +国家码）" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox Text="{Binding Prepend, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="固定使用此模组" Margin="0,10,0,6"/>
                        <ComboBox ItemsSource="{Binding DataContext.ViewModel.SipOutboundLineChoices, RelativeSource={RelativeSource AncestorType=Page}}" DisplayMemberPath="RuleLabel" SelectedValuePath="SlotId" SelectedValue="{Binding LineId}"/>
                        <ui:Button Content="移除规则" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding DataContext.ViewModel.RemoveSipDialRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="添加号码规则" HorizontalAlignment="Left" Command="{Binding ViewModel.AddSipDialRuleCommand}"/>
              </StackPanel>
            </Expander>
            <CheckBox Content="记住配置，并在启动时恢复上次 SIP 开关状态"
                      IsChecked="{Binding ViewModel.SipGatewayRestoreOnStartup}" Margin="0,0,0,6" />
            <TextBlock Text="导入不会立即启用。取消记住后，保存以清除已存密码。"
                       TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,14" />
            <ui:Button Margin="0,0,0,14" HorizontalAlignment="Left" Content="保存配置（不启用）" Command="{Binding ViewModel.SaveSipGatewaySettingsCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:Button Appearance="Primary" Content="{Binding ViewModel.SipGatewayActionText}" IsEnabled="{Binding ViewModel.CanToggleSipGateway}" Command="{Binding ViewModel.ToggleSipGatewayCommand}" />
              <ui:Button Margin="10,0,0,0" Content="刷新状态" Command="{Binding ViewModel.RefreshSipGatewayCommand}" />
              <controls:StatusIndicator Item="{Binding ViewModel.SipStatusIndicator}" Margin="16,0,0,0" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ViewModel.SipOperationNotice}" TextWrapping="Wrap">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.SipOperationNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Expander Header="连接详情" Margin="0,10,0,0" IsExpanded="False">
              <StackPanel>
            <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ViewModel.SipGatewayStatus}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ViewModel.SipRegisteredDevices}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
