<Page
  x:Class="VoWin.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:local="clr-namespace:VoWin.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="系统设置"
  d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="750"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource AppTextPrimaryBrush}"
  Foreground="{DynamicResource AppTextPrimaryBrush}"
  Background="{DynamicResource AppSurfaceBrush}"
  PreviewMouseWheel="OnPagePreviewMouseWheel"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <Style x:Key="ThemeChoiceStyle" TargetType="RadioButton">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="ChoiceCard"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" />
                <Grid Grid.Column="1" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Ellipse x:Name="ChoiceRing" Stroke="{DynamicResource AppCardBorderBrush}" StrokeThickness="1.5" />
                  <Ellipse x:Name="ChoiceDot" Width="8" Height="8" Fill="{DynamicResource AppAccentBrush}" Opacity="0" />
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChoiceCard" Property="Background" Value="{DynamicResource AppHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ChoiceCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ChoiceCard" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                <Setter TargetName="ChoiceCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="ChoiceRing" Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="ChoiceDot" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ChoiceCard" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="24,18,24,24" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent">
      <StackPanel>
        <TextBlock Style="{DynamicResource AppPageTitleStyle}" Text="设置" />
        <TextBlock Style="{DynamicResource AppPageSubtitleStyle}" Text="调整外观、通话行为与应用偏好" />
      </StackPanel>
    </Grid>

    <ScrollViewer
      x:Name="SettingsScrollViewer"
      Grid.Row="1"
      Background="Transparent"
      HorizontalContentAlignment="Stretch"
      VerticalScrollBarVisibility="Auto"
    >
      <StackPanel MaxWidth="920" HorizontalAlignment="Center" Background="Transparent">
        
        <!-- Section 1: Personalization -->
        <Border
          Margin="0,0,0,16"
          Padding="16,14"
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
        >
          <StackPanel>
            <TextBlock Style="{DynamicResource AppSectionTitleStyle}" Text="界面与个性化" />
            <TextBlock Style="{DynamicResource AppPageSubtitleStyle}" Margin="0,4,0,16" Text="主题选择会立即生效，并在下次启动时保留" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <RadioButton
                  Grid.Column="0"
                  Style="{StaticResource ThemeChoiceStyle}"
                  Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                  CommandParameter="theme_light"
                  GroupName="themeSelect"
                  IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="20" Margin="0,0,10,0" Foreground="{DynamicResource AppWarningBrush}" />
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="浅色主题" />
                      <TextBlock Style="{DynamicResource AppCaptionStyle}" Margin="0,2,0,0" Text="淡蓝画布 · 明亮清晰" />
                    </StackPanel>
                  </StackPanel>
              </RadioButton>
              <RadioButton
                  Grid.Column="2"
                  Style="{StaticResource ThemeChoiceStyle}"
                  Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                  CommandParameter="theme_dark"
                  GroupName="themeSelect"
                  IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="20" Margin="0,0,10,0" Foreground="{DynamicResource AppAccentBrush}" />
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="深色主题" />
                      <TextBlock Style="{DynamicResource AppCaptionStyle}" Margin="0,2,0,0" Text="海军蓝黑 · 低眩光" />
                    </StackPanel>
                  </StackPanel>
              </RadioButton>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Section 2: Telephony Preferences -->
        <Border
          Margin="0,0,0,16"
          Padding="16,14"
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
        >
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="策略" />
            <TextBlock Margin="0,4,0,20" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="全局行为设置" />

            <ui:ToggleSwitch
              Margin="0,0,0,16"
              IsChecked="{Binding ViewModel.AutoConnectKnownModem}"
              Content="自动挂载"
            />
            <ui:ToggleSwitch
              IsChecked="{Binding ViewModel.PreferVowifiCalling}"
              Content="语音呼叫与短信默认优先采用 VoWiFi"
            />
          </StackPanel>
        </Border>

        <Border Margin="0,0,0,16" Padding="16,14" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="通话音频与自动接听" />
            <TextBlock Margin="0,4,0,16" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="设置 VoLTE 音频启动速度、来电响铃和超时自动接听。" />
            <ui:ToggleSwitch Margin="0,0,0,8" IsChecked="{Binding ViewModel.VolteAudioPrewarmEnabled}" Content="启用 VoLTE 音频预热" />
            <Border Margin="0,0,0,18" Padding="12,9" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="8">
              <TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" Text="注意：开启 VoLTE 音频预热后，VoWin 会长期占用麦克风，以缩短接通后的音频启动时间。关闭后，麦克风只在实际通话时启用。" />
            </Border>
            <ui:ToggleSwitch Margin="0,0,0,8" IsChecked="{Binding ViewModel.SaveCallRecordings}" Content="保存 VoWiFi 通话录音" />
            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="录音将保存为 WAV（部分 AMR 通话会同时保存 AMR 原始音频）；每个文件夹最多保留最近 20 通，超过后自动成对清理最早录音。" TextWrapping="Wrap" />
            <TextBlock Text="录音保存文件夹" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,16">
              <ui:Button DockPanel.Dock="Right" Content="选择文件夹" Command="{Binding ViewModel.BrowseRecordingDirectoryCommand}" />
              <TextBox Margin="0,0,12,0" Text="{Binding ViewModel.RecordingDirectory, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ui:ToggleSwitch Margin="0,0,0,12" IsChecked="{Binding ViewModel.AutoAnswerEnabled}" Content="30 秒无人接听时自动接听" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <TextBlock VerticalAlignment="Center" Text="等待秒数" Margin="0,0,12,0" />
              <TextBox Width="80" Text="{Binding ViewModel.AutoAnswerDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock Text="接听后播放的录音文件" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,12">
              <ui:Button DockPanel.Dock="Right" Content="选择文件" Command="{Binding ViewModel.BrowseAutoAnswerMessageCommand}" />
              <TextBox Margin="0,0,12,0" Text="{Binding ViewModel.AutoAnswerMessagePath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ui:Button HorizontalAlignment="Left" Appearance="Primary" Content="保存通话设置" Command="{Binding ViewModel.SaveCallSettingsCommand}" />
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ViewModel.CallSettingsStatus}" />
          </StackPanel>
        </Border>

        <Border Margin="0,0,0,16" Padding="16,14" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="WireGuard SIP 网关" />
            <TextBlock Margin="0,4,0,14" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Text="让 Linphone、Zoiper 等标准 SIP 客户端通过 WireGuard 使用 VoWin 当前可用的通话线路。SIP/RTP 不应直接暴露到公网。" />
            <Border Margin="0,0,0,14" Padding="12,9" Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" Text="当前网关优先桥接 Windows 侧 VoWiFi IMS/RTP；蜂窝 Host IMS 在系统状态页确认 HostRoutable 并实验性注册后，也可作为 SIP/RTP 通话线路。两种 IMS 均不可用时，可回退到 AT + Quectel USB Audio 的基带 VoLTE/GSM。Host IMS 的运营商实网通话尚未验收，且不支持要求 ipsec-3gpp 的网络。QDC507 缺失 UAC 路由时才启用模组内 ADB 兼容后备；普通 UAC 与 Host IMS 均不依赖 ADB。密码只保存在本次应用进程内，不会写入磁盘。" />
            </Border>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,6" Text="WireGuard 本机地址" />
                <TextBox Text="{Binding ViewModel.SipGatewayBindAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 10.66.66.1" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,6" Text="SIP UDP 端口" />
                <TextBox Text="{Binding ViewModel.SipGatewayPort, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,6" Text="分机号" />
                <TextBox Text="{Binding ViewModel.SipGatewayExtension, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,6" Text="SIP 密码" />
                <ui:PasswordBox Password="{Binding ViewModel.SipGatewayPassword, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal">
              <ui:Button Appearance="Primary" Content="{Binding ViewModel.SipGatewayActionText}" Command="{Binding ViewModel.ToggleSipGatewayCommand}" />
              <ui:Button Margin="10,0,0,0" Content="刷新状态" Command="{Binding ViewModel.RefreshSipGatewayCommand}" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ViewModel.SipGatewayStatus}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
