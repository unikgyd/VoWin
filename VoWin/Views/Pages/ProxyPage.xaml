<Page
  x:Class="VoWin.Views.Pages.ProxyPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="网络分流与代理"
  d:DataContext="{d:DesignInstance vm:ProxyViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="720"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
    <helpers:NullToVisibilityConverter x:Key="NullToVis" />
  </Page.Resources>

  <Grid Margin="24,18,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Text="代理分流" />

      <ui:Button
        Grid.Column="1"
        VerticalAlignment="Center"
        Appearance="Secondary"
        Command="{Binding TestAllPresetsCommand}"
        Icon="{ui:SymbolIcon Symbol=Pulse24}"
        Content="批量测速所有节点"
      />
    </Grid>

    <!-- Status Banner -->
    <Border
      Grid.Row="1"
      Margin="0,0,0,12"
      Padding="14,8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8"
    >
      <Border.Effect>
        <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.04" ShadowDepth="1" Color="#000000" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="15" Margin="0,0,10,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding IsTesting, Converter={StaticResource InvertBoolToVis}}" />
        <ui:ProgressRing Grid.Column="1" Width="15" Height="15" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusMessage, Mode=OneWay}" />
      </Grid>
    </Border>

    <!-- Main Content TabControl -->
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
      
      <!-- TAB 1: 国家分流规则 (Country Dispatch) -->
      <TabItem Header="国家分流规则">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Top: Quick Add Bar (Search + Dropdown Combo) -->
          <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14"
          >
            <Border.Effect>
              <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Header line: Title + Hint -->
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="GlobeSearch24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="18" Margin="0,0,8,0" />
                  <TextBlock Text="添加国家 / 地区出站分流规则" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="自动关联电信 MCC 编码 · 即刻生效" VerticalAlignment="Center" />
              </Grid>

              <!-- Search & Select Row -->
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" MinWidth="260" />
                  <ColumnDefinition Width="2*" MinWidth="200" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Combo 1: Search + Select Country Dropdown -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                  <ComboBox
                    ItemsSource="{Binding FilteredAvailableCountries}"
                    SelectedItem="{Binding SelectedCountryToAdd, Mode=TwoWay}"
                    Text="{Binding CountrySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    HorizontalAlignment="Stretch"
                    Padding="10,7"
                  >
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Flag}" FontSize="18" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,8,0" />
                          <Border Grid.Column="2" Padding="6,1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                          </Border>
                          <TextBlock Grid.Column="3" Text="{Binding MccSummary}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <!-- Combo 2: Egress Route Dropdown -->
                <Grid Grid.Column="1" Margin="0,0,10,0">
                  <ComboBox
                    ItemsSource="{Binding AvailableEgressOptions}"
                    SelectedItem="{Binding QuickAddSelectedEgress, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch"
                    Padding="10,7"
                  />
                </Grid>

                <!-- Button: Add Rule -->
                <ui:Button
                  Grid.Column="2"
                  Appearance="Primary"
                  Padding="18,8"
                  Command="{Binding QuickAddCountryRuleCommand}"
                  Icon="{ui:SymbolIcon Symbol=Add24}"
                  Content="添加规则"
                />
              </Grid>

              <!-- Hint line -->
              <TextBlock
                Grid.Row="2"
                Margin="2,8,0,0"
                FontSize="11"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Text="{Binding QuickAddHintText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
              />
            </Grid>
          </Border>

          <!-- Middle: Rules List Card -->
          <Border
            Grid.Row="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
          >
            <Border.Effect>
              <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Header: Table Title + Search Existing Rules + Summary Pill -->
              <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Text="国家 / 地区分流策略映射表" />

                <Border
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="8,3"
                  CornerRadius="4"
                  VerticalAlignment="Center"
                >
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding RulesSummaryText}" />
                </Border>

                <!-- Filter Search Box for existing rules -->
                <ui:TextBox
                  Grid.Column="3"
                  PlaceholderText="搜索已有规则 (国家/节点/代码)..."
                  Text="{Binding RulesSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ClearButtonEnabled="True"
                  Padding="8,4"
                  FontSize="11"
                />
              </Grid>

              <!-- Country Rules ListView -->
              <ListView
                Grid.Row="1"
                ItemsSource="{Binding FilteredCountryRoutes}"
                SelectedItem="{Binding SelectedCountryRoute}"
                BorderThickness="0"
                Background="Transparent"
                Padding="2,2,2,4"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                MouseDoubleClick="OnRuleItemMouseDoubleClick"
              >
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border
                            x:Name="ItemBorder"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                          >
                            <Border.Effect>
                              <DropShadowEffect BlurRadius="4" Direction="270" Opacity="0.03" ShadowDepth="1" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <!-- Flag Emoji -->
                      <TextBlock Grid.Column="0" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" Text="{Binding FlagEmoji, Mode=OneWay}" />

                      <!-- Country Info & MCC -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding CountryName, Mode=OneWay}" />
                          <Border Margin="8,0,0,0" Padding="6,1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="10" Text="{Binding CountryCode, Mode=OneWay}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,3,0,0" Text="{Binding MccDisplay, Mode=OneWay}" />
                      </StackPanel>

                      <!-- Egress Result Badge (Neutral for DIRECT, Emerald for Proxy) -->
                      <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Padding="12,5"
                        Margin="0,0,12,0"
                        CornerRadius="6"
                        BorderThickness="1"
                      >
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#1F10B981" />
                            <Setter Property="BorderBrush" Value="#4D10B981" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="12" FontWeight="Medium">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#10B981" />
                              <Setter Property="Text" Value="{Binding ProxyNodeName, Mode=OneWay, StringFormat='代理 · {0}'}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                  <Setter Property="Text" Value="直连 (DIRECT)" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>

                      <!-- Row Action Buttons: Edit and Delete -->
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Edit Button -->
                        <ui:Button
                          Appearance="Secondary"
                          Padding="10,5"
                          Margin="0,0,6,0"
                          Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                          CommandParameter="{Binding}"
                          Icon="{ui:SymbolIcon Symbol=Edit24}"
                          Content="编辑"
                          ToolTip="编辑此分流规则 (或双击此行)"
                        />

                        <!-- Delete Button -->
                        <ui:Button
                          Appearance="Transparent"
                          Padding="6,5"
                          Foreground="#DC2626"
                          Command="{Binding DataContext.DeleteCountryRuleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                          CommandParameter="{Binding}"
                          Icon="{ui:SymbolIcon Symbol=Delete24}"
                          ToolTip="删除此分流规则"
                        />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 2: 节点预设池 (Node Library) -->
      <TabItem Header="代理节点池">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
          </Grid.ColumnDefinitions>

          <!-- Left: Presets List -->
          <Border
            Grid.Column="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
          >
            <Border.Effect>
              <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Text="已登记的 SOCKS5 / HTTP 代理节点" />
                <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="8,3" CornerRadius="4" VerticalAlignment="Center">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding NodePoolSummaryText}" />
                </Border>
              </Grid>

              <ListView
                Grid.Row="1"
                ItemsSource="{Binding Presets}"
                SelectedItem="{Binding SelectedPreset}"
                BorderThickness="0"
                Background="Transparent"
                Padding="2,2,2,4"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
              >
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border
                            x:Name="NodeBorder"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                          >
                            <Border.Effect>
                              <DropShadowEffect BlurRadius="4" Direction="270" Opacity="0.03" ShadowDepth="1" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="NodeBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                              <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="NodeBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                              <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <!-- Node Name & Address -->
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name, Mode=OneWay}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" Text="{Binding Url, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                      </StackPanel>

                      <!-- Latency Badge -->
                      <Border
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="4"
                      >
                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LatencyDisplay, Mode=OneWay}" />
                      </Border>

                      <!-- Inline Quick Test Button -->
                      <ui:Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Padding="8,4"
                        Margin="0,0,6,0"
                        Command="{Binding DataContext.TestPresetLatencyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Content="测速"
                        FontSize="11"
                      />

                      <!-- Delete Node Button -->
                      <ui:Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Icon="{ui:SymbolIcon Symbol=Delete24}"
                        ToolTip="删除此代理节点"
                      />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <!-- Right: Add Preset Card & Slot Fallback Card -->
          <StackPanel Grid.Column="2">
            <!-- Add Preset Card -->
            <Border
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="16"
              Margin="0,0,0,14"
            >
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
              </Border.Effect>
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="➕ 添加代理节点" Margin="0,0,0,8" />

                <!-- URL Quick Add -->
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="方式 1: 通过 URL 快速导入" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    PlaceholderText="socks5://user:pass@host:port"
                    Text="{Binding NewPresetUrl, UpdateSourceTrigger=PropertyChanged}"
                  />
                  <ui:Button
                    Grid.Column="1"
                    Appearance="Primary"
                    Command="{Binding AddPresetCommand}"
                    Content="导入"
                  />
                </Grid>

                <Separator Margin="0,0,0,12" />

                <!-- Manual Add Form -->
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="方式 2: 手动配置节点参数" Margin="0,0,0,6" />
                
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="节点名称：" Margin="0,0,0,2" />
                <ui:TextBox Margin="0,0,0,8" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: 专用香港节点" />

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="服务器 IP / 域名：" Margin="0,0,0,2" />
                    <ui:TextBox Text="{Binding NewPresetHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="127.0.0.1" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="端口：" Margin="0,0,0,2" />
                    <ui:TextBox Text="{Binding NewPresetPort, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="用户名 (可选)：" Margin="0,0,0,2" />
                    <ui:TextBox Text="{Binding NewPresetUsername, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="密码 (可选)：" Margin="0,0,0,2" />
                    <ui:PasswordBox Password="{Binding NewPresetPassword, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>

                <ui:Button
                  Appearance="Primary"
                  Command="{Binding AddNewPresetCommand}"
                  Content="保存至节点池"
                  HorizontalAlignment="Stretch"
                />
              </StackPanel>
            </Border>

            <!-- Slot Binding Quick Card -->
            <Border
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="16"
            >
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
              </Border.Effect>
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="卡槽全局代理绑定" Margin="0,0,0,4" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="将代理直接绑定到指定硬件 SIM 卡槽：" Margin="0,0,0,10" TextWrapping="Wrap" />

                <ComboBox
                  ItemsSource="{Binding Slots}"
                  SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                  DisplayMemberPath="DisplayTitle"
                  Margin="0,0,0,10"
                  HorizontalAlignment="Stretch"
                />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:Button
                    Grid.Column="0"
                    Appearance="Secondary"
                    Command="{Binding ApplyPresetToSlotCommand}"
                    CommandParameter="{Binding SelectedPreset}"
                    Content="应用选中节点"
                    HorizontalAlignment="Stretch"
                    FontSize="12"
                  />
                  <ui:Button
                    Grid.Column="2"
                    Appearance="Secondary"
                    Command="{Binding ClearSlotProxyCommand}"
                    CommandParameter="{Binding SelectedSlot}"
                    Content="恢复卡槽直连"
                    HorizontalAlignment="Stretch"
                    FontSize="12"
                  />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>

    </TabControl>

    <!-- Modal Edit Dialog Overlay (悬浮窗编辑 / Dialog) -->
    <Grid
      x:Name="EditDialogOverlay"
      Grid.RowSpan="3"
      Margin="-24,-18,-24,-24"
      Background="#99000000"
      Visibility="{Binding IsEditingRoute, Converter={StaticResource BoolToVis}}"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Panel.ZIndex="200"
    >
      <!-- Centered Dialog Card -->
      <Border
        Width="500"
        MaxHeight="600"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="16"
        Padding="24,20"
      >
        <Border.Effect>
          <DropShadowEffect BlurRadius="32" Direction="270" Opacity="0.30" ShadowDepth="8" Color="#000000" />
        </Border.Effect>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Header with Title & Close button -->
          <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Edit24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="18" Margin="0,0,8,0" />
              <TextBlock Text="编辑国家分流策略" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <ui:Button
              Grid.Column="1"
              Appearance="Transparent"
              Padding="6,4"
              Icon="{ui:SymbolIcon Symbol=Dismiss24}"
              Command="{Binding CloseEditDialogCommand}"
              ToolTip="关闭 (Esc)"
            />
          </Grid>

          <!-- Target Country Info Card -->
          <Border
            Grid.Row="1"
            Padding="14,12"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="0,0,0,16"
          >
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding EditingRoute.FlagEmoji, FallbackValue='🌐'}" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding EditingRoute.CountryName, FallbackValue='--'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <Border Margin="8,0,0,0" Padding="6,1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                    <TextBlock Text="{Binding EditingRoute.CountryCode, FallbackValue='--'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding EditingRoute.MccDisplay, FallbackValue='--', Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Egress Mode Radio Selection -->
          <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="出站分流策略：" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />

            <!-- Option 1: Direct -->
            <Border
              Padding="12,10"
              Margin="0,0,0,8"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
            >
              <RadioButton
                GroupName="EditDialogEgressGroup"
                IsChecked="{Binding EditDialogIsDirect, Mode=TwoWay}"
              >
                <StackPanel Margin="6,0,0,0">
                  <TextBlock Text="直连模式 (DIRECT)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="通过默认物理网卡直连运营商核心网，不走代理隧道" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
              </RadioButton>
            </Border>

            <!-- Option 2: Proxy -->
            <Border
              Padding="12,10"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
            >
              <RadioButton
                GroupName="EditDialogEgressGroup"
                IsChecked="{Binding EditDialogIsProxy, Mode=TwoWay}"
              >
                <StackPanel Margin="6,0,0,0">
                  <TextBlock Text="代理节点 (Proxy)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="经由指定 SOCKS5 / HTTP 代理隧道转发流量" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
              </RadioButton>
            </Border>
          </StackPanel>

          <!-- Node Selector (Enabled when Proxy is selected) -->
          <StackPanel Grid.Row="3" Margin="0,0,0,18" IsEnabled="{Binding EditDialogIsProxy}">
            <TextBlock Text="选择出站代理节点：" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
            <ComboBox
              ItemsSource="{Binding Presets}"
              SelectedItem="{Binding EditDialogSelectedNode, Mode=TwoWay}"
              DisplayMemberPath="Name"
              HorizontalAlignment="Stretch"
              Padding="10,7"
            />
          </StackPanel>

          <!-- Separator -->
          <Separator Grid.Row="4" Margin="0,0,0,16" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

          <!-- Action Footer -->
          <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Delete Button -->
            <ui:Button
              Grid.Column="0"
              Appearance="Transparent"
              Foreground="#DC2626"
              Icon="{ui:SymbolIcon Symbol=Delete24}"
              Command="{Binding DeleteCountryRuleCommand}"
              CommandParameter="{Binding EditingRoute}"
              Content="删除此规则"
              FontSize="12"
            />

            <!-- Cancel Button -->
            <ui:Button
              Grid.Column="2"
              Appearance="Secondary"
              Content="取消"
              Command="{Binding CloseEditDialogCommand}"
              Margin="0,0,8,0"
              Padding="18,7"
            />

            <!-- Save Changes Button -->
            <ui:Button
              Grid.Column="3"
              Appearance="Primary"
              Content="保存更改"
              Command="{Binding SaveEditDialogCommand}"
              Padding="20,7"
            />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
