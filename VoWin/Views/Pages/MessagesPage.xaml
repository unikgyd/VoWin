<Page
  x:Class="VoWin.Views.Pages.MessagesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="短信"
  d:DataContext="{d:DesignInstance vm:MessagesViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="750"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
    <helpers:NullToVisibilityConverter x:Key="NullToVis" />
    <helpers:NullToVisibilityConverter x:Key="InvertNullToVis" Invert="True" />
    
    <helpers:SmsDirectionToAlignmentConverter x:Key="SmsAlign" />
    <helpers:SmsDirectionToMarginConverter x:Key="SmsMargin" />
    <helpers:SmsDirectionToColorConverter x:Key="SmsColor" />
    <helpers:SmsDirectionToForegroundConverter x:Key="SmsForeground" />
  </Page.Resources>

  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <TextBlock
        FontSize="24"
        FontWeight="SemiBold"
        Text="短信"
      />
    </Grid>

    <!-- Main Dual-Pane Container -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Pane: Conversations List -->
      <Border
        Grid.Column="0"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="14"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Top Action: Search & New Chat Button -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
              Grid.Column="0"
              Margin="0,0,8,0"
              PlaceholderText="搜索会话..."
              Icon="Search24"
              Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
            />
            <ui:Button
              Grid.Column="1"
              Appearance="Primary"
              Command="{Binding StartNewChatCommand}"
              Icon="{ui:SymbolIcon Symbol=Compose24}"
              ToolTip="新建对话"
            />
          </Grid>

          <!-- New Chat Input Bar (Expandable) -->
          <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="8"
            Visibility="{Binding IsCreatingNewChat, Converter={StaticResource BoolToVis}}"
          >
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <ui:TextBox
                Grid.Row="0"
                Margin="0,0,0,10"
                PlaceholderText="收件人 (例如: 10086)..."
                Text="{Binding NewRecipientInput, UpdateSourceTrigger=PropertyChanged}"
              />

              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button
                  Command="{Binding CancelNewChatCommand}"
                  Appearance="Transparent"
                  Content="取消"
                  Margin="0,0,8,0"
                />
                <ui:Button
                  Appearance="Primary"
                  Command="{Binding ConfirmNewChatCommand}"
                  Content="开始"
                />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Conversations List -->
          <ListView
            Grid.Row="2"
            ItemsSource="{Binding ConversationsView}"
            SelectedItem="{Binding SelectedConversation}"
            BorderThickness="0"
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
          >
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <Border
                        x:Name="ItemBorder"
                        Background="Transparent"
                        BorderThickness="3,0,0,0"
                        BorderBrush="Transparent"
                        CornerRadius="8"
                        Padding="10,10"
                        Margin="2,1"
                      >
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ItemBorder" Property="Background" Value="#0A000000" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="ItemBorder" Property="Background" Value="#122563EB" />
                          <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2563EB" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Avatar -->
                  <Border
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="{Binding AvatarColor, FallbackValue='#2563EB'}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                  >
                    <TextBlock
                      FontSize="16"
                      FontWeight="SemiBold"
                      Foreground="White"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Text="{Binding RemotePartyInitial}"
                    />
                  </Border>

                  <!-- Center Info -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                      FontWeight="SemiBold"
                      FontSize="14"
                      Text="{Binding RemoteParty}"
                      TextTrimming="CharacterEllipsis"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    />
                    <TextBlock
                      Margin="0,3,0,0"
                      FontSize="12"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding LatestMessageSummary}"
                      TextTrimming="CharacterEllipsis"
                      MaxHeight="18"
                    />
                  </StackPanel>

                  <!-- Right: Time & Unread Badge -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock
                      FontSize="11"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="{Binding FormattedLatestTime}"
                      HorizontalAlignment="Right"
                    />
                    <Border
                      Margin="0,4,0,0"
                      HorizontalAlignment="Right"
                      Padding="6,2"
                      CornerRadius="10"
                      Background="#2563EB"
                      Visibility="{Binding UnreadCount, Converter={StaticResource BoolToVis}}"
                    >
                      <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding UnreadCount}"
                      />
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <!-- Right Pane: Chat History & Input Box -->
      <Border
        Grid.Column="2"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="0"
        Visibility="{Binding SelectedConversation, Converter={StaticResource NullToVis}}"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Chat Header -->
          <Border
            Grid.Row="0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,12"
          >
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Contact Info -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border
                  Width="38"
                  Height="38"
                  CornerRadius="19"
                  Background="{Binding SelectedConversation.AvatarColor, FallbackValue='#2563EB'}"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                >
                  <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding SelectedConversation.RemotePartyInitial}"
                  />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedConversation.RemoteParty}"
                  />
                  <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SelectedConversation.ContactNumber}"
                  />
                </StackPanel>
              </StackPanel>
              
              <!-- Action Toolbar -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button
                  Appearance="Secondary"
                  Icon="{ui:SymbolIcon Symbol=Call24}"
                  Command="{Binding CallContactCommand}"
                  ToolTip="呼叫此联系人"
                  Content="呼叫"
                  Margin="0,0,8,0"
                />
                <ui:Button
                  x:Name="MoreActionsBtn"
                  Appearance="Transparent"
                  Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}"
                  ToolTip="会话管理操作"
                  Click="OnMoreActionsClick"
                >
                  <ui:Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="复制联系人号码" Click="OnCopyContactNumberClick">
                        <MenuItem.Icon>
                          <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="模拟验证码弹窗 (测试)" Click="OnTestOtpNotificationClick">
                        <MenuItem.Icon>
                          <ui:SymbolIcon Symbol="Key24" FontSize="16" Foreground="#2563EB" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="清空会话记录" Click="OnClearConversationClick">
                        <MenuItem.Icon>
                          <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="删除整个会话" Click="OnDeleteConversationClick">
                        <MenuItem.Icon>
                          <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="#DC2626" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </ui:Button.ContextMenu>
                </ui:Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Chat Bubbles Area -->
          <ListView
            Grid.Row="1"
            x:Name="MessagesListView"
            ItemsSource="{Binding SelectedConversation.Messages}"
            BorderThickness="0"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            Padding="20,16"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
          >
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel
                  HorizontalAlignment="{Binding Direction, Converter={StaticResource SmsAlign}}"
                  Margin="{Binding Direction, Converter={StaticResource SmsMargin}}"
                >
                  <!-- Message Bubble -->
                  <Border
                    CornerRadius="14"
                    Padding="14,10,14,10"
                    MaxWidth="460"
                  >
                    <Border.Style>
                      <Style TargetType="Border">
                        <!-- Default / Incoming: Dynamic adaptive card in both light & dark mode -->
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                            <Setter Property="Background" Value="#2563EB" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>

                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="复制短信内容" Click="OnBubbleCopyClick">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="删除此短信" Click="OnBubbleDeleteClick">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Border.ContextMenu>

                    <StackPanel>
                      <!-- Message Text -->
                      <TextBlock
                        FontSize="14"
                        TextWrapping="Wrap"
                        Text="{Binding Text}"
                        LineHeight="21"
                      >
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <!-- OTP Code Copy Pill (if detected) -->
                      <Button
                        Margin="0,8,0,2"
                        Padding="10,6"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnCopyOtpButtonClick"
                        Tag="{Binding ExtractedOtpCode}"
                        Visibility="{Binding HasOtpCode, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left"
                      >
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="6"
                              Padding="{TemplateBinding Padding}"
                            >
                              <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Key24" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="复制验证码: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ExtractedOtpCode}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                              </StackPanel>
                            </Border>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>

                      <!-- Send Failed Warning & Retry -->
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="13" Foreground="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="发送失败" FontSize="11" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button
                          Padding="6,2"
                          Background="#FEE2E2"
                          BorderBrush="#FCA5A5"
                          BorderThickness="1"
                          Cursor="Hand"
                          Click="OnRetryMessageClick"
                          Tag="{Binding}"
                        >
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="重试" FontSize="11" Foreground="#DC2626" FontWeight="Medium"/>
                              </Border>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </StackPanel>

                      <!-- Footer: Timestamp, Status and One-Click Copy -->
                      <DockPanel Margin="0,6,0,0" LastChildFill="False">
                        <TextBlock
                          DockPanel.Dock="Left"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Opacity="0.75"
                        >
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                  <Setter Property="Foreground" Value="#E0E7FF" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                          <Run Text="{Binding FormattedTimestamp, Mode=OneWay}" />
                          <Run Text="{Binding DeliveryStatusText, Mode=OneWay}" />
                        </TextBlock>

                        <Button
                          DockPanel.Dock="Right"
                          Padding="4,2"
                          Height="20"
                          Margin="8,0,0,0"
                          Cursor="Hand"
                          ToolTip="复制此条短信"
                          Click="OnQuickCopyMessageClick"
                          Tag="{Binding}"
                        >
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <ui:SymbolIcon
                                Symbol="Copy24"
                                FontSize="12"
                                Opacity="0.6"
                              >
                                <ui:SymbolIcon.Style>
                                  <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ui:SymbolIcon.Style>
                              </ui:SymbolIcon>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <!-- Chat Input Box Area -->
          <Border
            Grid.Row="2"
            Padding="20,14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,12,12"
          >
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              
              <!-- Status & Module/SIM Selector & Character Count -->
              <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Slot / SIM Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="Sim24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <ComboBox
                    MinWidth="180"
                    Height="28"
                    FontSize="12"
                    Padding="8,2"
                    ItemsSource="{Binding Slots}"
                    SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                    DisplayMemberPath="DisplayTitle"
                    ToolTip="选择发送短信的模组 / SIM 卡"
                  />
                </StackPanel>

                <!-- Character & Segment Count -->
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4">
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding CharacterCountInfo}"
                  />
                </Border>
              </Grid>

              <TextBlock
                Grid.Row="1"
                Margin="0,0,0,6"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"
              />

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                  x:Name="MessageInputBox"
                  Grid.Column="0"
                  TextWrapping="Wrap"
                  AcceptsReturn="True"
                  MinHeight="46"
                  MaxHeight="120"
                  VerticalScrollBarVisibility="Auto"
                  Padding="10,8"
                  FontSize="13"
                  PreviewKeyDown="OnMessageInputKeyDown"
                  Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                />
                <Button
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  Width="44"
                  Height="44"
                  Background="#2563EB"
                  BorderThickness="0"
                  Cursor="Hand"
                  Command="{Binding SendMessageCommand}"
                  VerticalAlignment="Bottom"
                  ToolTip="发送短信 (Enter 或 Ctrl+Enter，Shift+Enter换行)"
                >
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border
                        x:Name="sendBtn"
                        Background="{TemplateBinding Background}"
                        CornerRadius="22"
                      >
                        <Grid>
                          <ui:SymbolIcon
                            x:Name="sendIcon"
                            Symbol="Send24"
                            FontSize="18"
                            Foreground="White"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                          />
                          <ui:ProgressRing
                            x:Name="sendSpinner"
                            Width="18"
                            Height="18"
                            Foreground="White"
                            IsIndeterminate="True"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                          />
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="sendBtn" Property="Background" Value="#1D4ED8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="sendBtn" Property="Background" Value="#1E40AF"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSending}" Value="True">
                          <Setter TargetName="sendIcon" Property="Visibility" Value="Collapsed"/>
                          <Setter TargetName="sendSpinner" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter TargetName="sendBtn" Property="Opacity" Value="0.45" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Empty State when no conversation is selected -->
      <Border
        Grid.Column="2"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Visibility="{Binding SelectedConversation, Converter={StaticResource InvertNullToVis}}"
      >
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ui:SymbolIcon
            FontSize="56"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Symbol="ChatMultiple24"
          />
          <TextBlock
            Margin="0,18,0,0"
            FontSize="18"
            FontWeight="Medium"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="选择一个会话开始畅聊"
          />
          <TextBlock
            Margin="0,6,0,0"
            FontSize="13"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="或点击左上角的 + 号发起新对话"
          />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
