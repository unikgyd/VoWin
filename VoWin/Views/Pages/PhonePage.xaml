<Page
  x:Class="VoWin.Views.Pages.PhonePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:controls="clr-namespace:VoWin.Views.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="电话"
  d:DataContext="{d:DesignInstance vm:PhoneViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="780"
  d:DesignWidth="1140"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource AppTextPrimaryBrush}"
  Foreground="{DynamicResource AppTextPrimaryBrush}"
  ScrollViewer.VerticalScrollBarVisibility="Disabled"
  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
    <helpers:CallStateToColorConverter x:Key="CallStateColor" />
    <helpers:CallRecordToSymbolConverter x:Key="CallRecordSymbol" />
    <helpers:CallRecordToColorConverter x:Key="CallRecordColor" />

    <!-- Style for Circular In-Call Control Buttons -->
    <Style x:Key="InCallActionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="68" />
      <Setter Property="Height" Value="68" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="border"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="34"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Style for Modern DTMF Grid Buttons -->
    <Style x:Key="DtmfKeypadButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="58" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="border"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="10"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="24,18,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock
          Style="{DynamicResource AppPageTitleStyle}"
          Text="电话"
          VerticalAlignment="Center"
        />
        <Border
          Margin="12,0,0,0"
          Padding="8,3"
          CornerRadius="6"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
          VerticalAlignment="Center"
        >
          <TextBlock
            Text="{Binding VoWifiStateText}"
            FontSize="12"
            Foreground="{DynamicResource AppTextSecondaryBrush}"
          />
        </Border>
      </StackPanel>
    </Grid>

    <!-- Main Content Area: Left Dialer / In-Call, Right History -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" MinWidth="400" MaxWidth="480" />
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Dialer / In-Call Card -->
      <Border
        Grid.Column="0"
        Background="{DynamicResource AppCardBrush}"
        BorderBrush="{DynamicResource AppCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="24"
        Padding="24,20"
      >
        <Grid>
          <!-- 1. PRE-CALL IDLE STATE: High-efficiency Input + Vintage Rotary Dial -->
          <Grid Visibility="{Binding IsDialerVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Phone Number Input Box (Keyboard typing, Enter to dial, Clear button, Mode toggle) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" Height="52">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ui:TextBox
                Grid.Column="0"
                FontSize="28"
                FontWeight="Light"
                TextAlignment="Center"
                BorderThickness="0,0,0,1.5"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="Transparent"
                VerticalAlignment="Center"
                Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                PreviewKeyDown="OnPhoneNumberKeyDown"
                PlaceholderText="输入或粘贴电话号码"
              />

              <ui:Button
                Grid.Column="1"
                Margin="4,0,0,0"
                Height="40"
                Width="40"
                Appearance="Transparent"
                Command="{Binding BackspaceCommand}"
                Icon="{ui:SymbolIcon Symbol=Backspace24, FontSize=18}"
                ToolTip="退格删除"
              />

              <ui:Button
                Grid.Column="2"
                Margin="2,0,0,0"
                Height="40"
                Width="40"
                Appearance="Transparent"
                Command="{Binding ToggleDialerModeCommand}"
                Icon="{ui:SymbolIcon Symbol=Dialpad24, FontSize=18}"
                ToolTip="切换复古转盘 / 现代数字键盘"
              />
            </Grid>

            <!-- Center Dialing Area: Vintage Rotary Dial OR Modern 3x4 Keypad -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
              <!-- Mode A: Vintage Skeuomorphic Rotary Dial Control -->
              <controls:RotaryDialControl
                x:Name="RotaryDial"
                DigitDialedCommand="{Binding AppendDigitCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding UseRotaryDial, Converter={StaticResource BoolToVis}}"
              />

              <!-- Mode B: Modern 3x4 Digital Keypad -->
              <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding UseRotaryDial, Converter={StaticResource InvertBoolToVis}}"
              >
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 1: 1, 2, 3 -->
                <Button Grid.Row="0" Grid.Column="0" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="1">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="1" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text=" " FontSize="9" Opacity="0.4" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="2">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="2" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="ABC" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="2" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="3">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="3" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="DEF" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- Row 2: 4, 5, 6 -->
                <Button Grid.Row="1" Grid.Column="0" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="4">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="4" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="GHI" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="5">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="5" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="JKL" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="2" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="6">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="6" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="MNO" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- Row 3: 7, 8, 9 -->
                <Button Grid.Row="2" Grid.Column="0" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="7">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="7" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="PQRS" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="1" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="8">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="8" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="TUV" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="2" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="9">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="9" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="WXYZ" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- Row 4: *, 0, # -->
                <Button Grid.Row="3" Grid.Column="0" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="*">
                  <TextBlock Text="*" FontSize="26" FontWeight="SemiBold" Margin="0,-4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Grid.Row="3" Grid.Column="1" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="0">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="+" FontSize="9" FontWeight="Medium" Opacity="0.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="2" Width="74" Height="58" Margin="6" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="#">
                  <TextBlock Text="#" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </Grid>
            </Grid>

            <!-- Bottom Call Action & Card Selector -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Center">
              <!-- Primary Green Call Button -->
              <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button
                  Width="220"
                  Height="48"
                  Background="{DynamicResource AppSuccessBrush}"
                  BorderThickness="0"
                  Cursor="Hand"
                  Command="{Binding DialCommand}"
                  ToolTip="发起语音呼叫 (快捷键: Enter)"
                >
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border
                        x:Name="callBtn"
                        Background="{TemplateBinding Background}"
                        CornerRadius="24"
                      >
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#16A34A" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <ui:SymbolIcon
                            FontSize="22"
                            Foreground="White"
                            Symbol="Call24"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                          />
                          <TextBlock
                            Text="呼叫"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            VerticalAlignment="Center"
                          />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="callBtn" Property="Background" Value="{DynamicResource AppSuccessBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="callBtn" Property="Background" Value="{DynamicResource AppSuccessBrush}" />
                          <Setter TargetName="callBtn" Property="RenderTransform">
                            <Setter.Value>
                              <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="110" CenterY="24" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter TargetName="callBtn" Property="Opacity" Value="0.45" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>

                <!-- Loading progress indicator while preparing call -->
                <ui:ProgressRing
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,24,0"
                  IsIndeterminate="True"
                  Visibility="{Binding IsCallOperationPending, Converter={StaticResource BoolToVis}}"
                />
              </Grid>

              <!-- Line / Slot Selector under the Call Button -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Sim24" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="拨打卡槽:" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox
                  Width="180"
                  Height="30"
                  FontSize="12"
                  Padding="6,2"
                  ItemsSource="{Binding Slots}"
                  SelectedItem="{Binding SelectedSlot}"
                  DisplayMemberPath="DisplayTitle"
                />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 2. IN-CALL EXPERIENCE & ENDED STATE SCREEN -->
          <Grid Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Caller Information & Call State Header Card -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16,0,16">
              <!-- Caller Avatar with semantic state color ring -->
              <Border
                Width="108"
                Height="108"
                Background="{DynamicResource AppInputBrush}"
                BorderBrush="{Binding CurrentCallState, Converter={StaticResource CallStateColor}}"
                BorderThickness="3"
                CornerRadius="54"
                HorizontalAlignment="Center"
                Margin="0,0,0,18"
              >
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.10" Color="#000000" />
                </Border.Effect>
                <ui:SymbolIcon
                  FontSize="50"
                  Foreground="{Binding CurrentCallState, Converter={StaticResource CallStateColor}}"
                  Symbol="Person24"
                />
              </Border>

              <!-- Phone Number -->
              <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AppTextPrimaryBrush}"
                HorizontalAlignment="Center"
                Text="{Binding ActiveCallNumber, FallbackValue='未知号码'}"
              />

              <!-- Call State Title -->
              <TextBlock
                Margin="0,8,0,0"
                FontSize="15"
                Foreground="{Binding CurrentCallState, Converter={StaticResource CallStateColor}}"
                FontWeight="Medium"
                HorizontalAlignment="Center"
                Text="{Binding CallStatusTitle}"
              />

              <!-- Call Duration Timer (Shown when Connected or Held) -->
              <TextBlock
                Margin="0,10,0,0"
                FontSize="38"
                FontFamily="Consolas, Segoe UI"
                FontWeight="Light"
                Foreground="{DynamicResource AppTextPrimaryBrush}"
                HorizontalAlignment="Center"
                Text="{Binding CallDurationText}"
                Visibility="{Binding IsCallTimerVisible, Converter={StaticResource BoolToVis}}"
              />

              <!-- Subtitle or Network Status (When not connected) -->
              <TextBlock
                Margin="0,6,0,0"
                FontSize="13"
                Foreground="{DynamicResource AppTextSecondaryBrush}"
                HorizontalAlignment="Center"
                Text="{Binding CallStatusSubtitle}"
                Visibility="{Binding IsCallTimerVisible, Converter={StaticResource InvertBoolToVis}}"
              />

              <!-- High Definition Codec Pill Badge (Shown when connected) -->
              <Border
                Margin="0,12,0,0"
                Padding="12,4"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6"
                HorizontalAlignment="Center"
                Visibility="{Binding IsCallConnected, Converter={StaticResource BoolToVis}}"
              >
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Voicemail24" FontSize="14" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{DynamicResource AppTextSecondaryBrush}"
                    Text="{Binding CodecInfo}"
                  />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Middle Section: Normal Controls vs Ended Summary vs Incoming Dialog -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
              <!-- A. Normal In-Call Actions (When not ended and not incoming) -->
              <StackPanel Visibility="{Binding IsEndedVisible, Converter={StaticResource InvertBoolToVis}}">
                <!-- Control Buttons Row: Mute, Keypad, Hold -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                  <!-- Mute Button -->
                  <StackPanel HorizontalAlignment="Center">
                    <Button
                      Style="{StaticResource InCallActionButtonStyle}"
                      Command="{Binding ToggleMuteCommand}"
                      ToolTip="切换麦克风静音"
                    >
                      <Grid>
                        <ui:SymbolIcon
                          FontSize="24"
                          Foreground="{DynamicResource AppDangerBrush}"
                          Symbol="MicOff24"
                          Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"
                        />
                        <ui:SymbolIcon
                          FontSize="24"
                          Symbol="Mic24"
                          Visibility="{Binding IsMuted, Converter={StaticResource InvertBoolToVis}}"
                        />
                      </Grid>
                    </Button>
                    <TextBlock
                      Margin="0,6,0,0"
                      FontSize="12"
                      HorizontalAlignment="Center"
                    >
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="静音" />
                          <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                              <Setter Property="Text" Value="已静音" />
                              <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>

                  <!-- DTMF Keypad Button -->
                  <StackPanel HorizontalAlignment="Center">
                    <Button
                      Style="{StaticResource InCallActionButtonStyle}"
                      Command="{Binding ToggleKeypadCommand}"
                      ToolTip="展开/收起数字小键盘"
                    >
                      <ui:SymbolIcon FontSize="24" Symbol="Dialpad24" />
                    </Button>
                    <TextBlock
                      Margin="0,6,0,0"
                      FontSize="12"
                      Foreground="{DynamicResource AppTextSecondaryBrush}"
                      HorizontalAlignment="Center"
                      Text="键盘"
                    />
                  </StackPanel>

                  <!-- Hold Button -->
                  <StackPanel HorizontalAlignment="Center">
                    <Button
                      Style="{StaticResource InCallActionButtonStyle}"
                      Command="{Binding ToggleHoldCommand}"
                      ToolTip="通话保持与恢复"
                    >
                      <Grid>
                        <ui:SymbolIcon
                          FontSize="24"
                          Foreground="{DynamicResource AppWarningBrush}"
                          Symbol="Play24"
                          Visibility="{Binding IsHeld, Converter={StaticResource BoolToVis}}"
                        />
                        <ui:SymbolIcon
                          FontSize="24"
                          Symbol="Pause24"
                          Visibility="{Binding IsHeld, Converter={StaticResource InvertBoolToVis}}"
                        />
                      </Grid>
                    </Button>
                    <TextBlock
                      Margin="0,6,0,0"
                      FontSize="12"
                      HorizontalAlignment="Center"
                    >
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="保持" />
                          <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeld}" Value="True">
                              <Setter Property="Text" Value="恢复" />
                              <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </StackPanel>

                <!-- Audio Output Device Selector Card -->
                <Border
                  Width="340"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource AppInputBrush}"
                  BorderBrush="{DynamicResource AppCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="14,10"
                  Margin="0,6,0,6"
                >
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
                  </Border.Effect>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Speaker Icon Badge & Label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                      <Border
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                      >
                        <ui:SymbolIcon
                          Symbol="Speaker224"
                          FontSize="15"
                          Foreground="{DynamicResource AppAccentBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                        />
                      </Border>
                      <TextBlock
                        Text="声卡设备"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                        VerticalAlignment="Center"
                      />
                    </StackPanel>

                    <!-- Right: Full-width Fluent ComboBox -->
                    <ComboBox
                      Grid.Column="1"
                      Height="34"
                      FontSize="12"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding AudioDevices}"
                      SelectedItem="{Binding SelectedAudioDevice}"
                      ToolTip="{Binding SelectedAudioDevice}"
                    >
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock
                            Text="{Binding}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                          />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>
              </StackPanel>

              <!-- B. Ended Call Summary & Action Buttons (Shown when call has ended) -->
              <StackPanel Visibility="{Binding IsEndedVisible, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                <TextBlock
                  Text="{Binding CallStatusSubtitle}"
                  FontSize="13"
                  Foreground="{DynamicResource AppTextSecondaryBrush}"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,16"
                />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <ui:Button
                    Margin="0,0,12,0"
                    Height="40"
                    Appearance="Primary"
                    Command="{Binding RedialCurrentCommand}"
                    Icon="{ui:SymbolIcon Symbol=Call24}"
                    Content="再次呼叫"
                  />
                  <ui:Button
                    Height="40"
                    Appearance="Secondary"
                    Command="{Binding ReturnToDialerCommand}"
                    Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                    Content="返回拨号盘"
                  />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Bottom Call Control (Hangup or Answer/Reject) -->
            <Grid Grid.Row="2" HorizontalAlignment="Center">
              <!-- Regular Red Hangup Button (When not incoming and not ended) -->
              <Button
                Width="200"
                Height="48"
                Background="{DynamicResource AppDangerBrush}"
                BorderThickness="0"
                Cursor="Hand"
                Command="{Binding HangupCommand}"
                ToolTip="结束本次通话"
                Visibility="{Binding IsEndedVisible, Converter={StaticResource InvertBoolToVis}}"
              >
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border
                      x:Name="hangupBtn"
                      Background="{TemplateBinding Background}"
                      CornerRadius="24"
                    >
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#DC2626" />
                      </Border.Effect>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon
                          FontSize="22"
                          Foreground="White"
                          Symbol="CallDismiss24"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Text="挂断"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Foreground="White"
                          VerticalAlignment="Center"
                        />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="hangupBtn" Property="Background" Value="{DynamicResource AppDangerBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="hangupBtn" Property="Background" Value="{DynamicResource AppDangerBrush}" />
                        <Setter TargetName="hangupBtn" Property="RenderTransform">
                          <Setter.Value>
                            <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="24" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>

            <!-- 3. POPUP OVERLAY: Modern In-Call DTMF 3x4 Keypad -->
            <Border
              Grid.RowSpan="3"
              Background="{DynamicResource AppCardBrush}"
              BorderBrush="{DynamicResource AppCardBorderBrush}"
              BorderThickness="1"
              CornerRadius="20"
              Padding="18,16"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Width="340"
              Margin="0,0,0,10"
              Visibility="{Binding ShowInCallKeypad, Converter={StaticResource BoolToVis}}"
            >
              <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.20" Color="#000000" />
              </Border.Effect>
              <StackPanel>
                <!-- Keypad Header with Close button -->
                <Grid Margin="0,0,0,12">
                  <TextBlock
                    Text="数字键盘 (DTMF)"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                  />
                  <ui:Button
                    HorizontalAlignment="Right"
                    Appearance="Transparent"
                    Command="{Binding ToggleKeypadCommand}"
                    Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=16}"
                    ToolTip="收起键盘"
                  />
                </Grid>

                <!-- Dialed DTMF History -->
                <Border
                  Height="36"
                  Background="{DynamicResource AppInputBrush}"
                  CornerRadius="8"
                  Padding="10,0"
                  Margin="0,0,0,12"
                >
                  <TextBlock
                    Text="{Binding DtmfSentHistory, FallbackValue=''}"
                    FontSize="18"
                    FontFamily="Consolas, Segoe UI"
                    FontWeight="Medium"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                  />
                </Border>

                <!-- Modern 3x4 Grid -->
                <Grid HorizontalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Row 1: 1, 2, 3 -->
                  <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="1">
                    <TextBlock Text="1" FontSize="20" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="2">
                    <TextBlock Text="2" FontSize="20" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="3">
                    <TextBlock Text="3" FontSize="20" FontWeight="SemiBold" />
                  </Button>

                  <!-- Row 2: 4, 5, 6 -->
                  <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="4">
                    <TextBlock Text="4" FontSize="20" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="5">
                    <TextBlock Text="5" FontSize="20" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="6">
                    <TextBlock Text="6" FontSize="20" FontWeight="SemiBold" />
                  </Button>

                  <!-- Row 3: 7, 8, 9 -->
                  <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="7">
                    <TextBlock Text="7" FontSize="20" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="8">
                    <TextBlock Text="8" FontSize="20" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="9">
                    <TextBlock Text="9" FontSize="20" FontWeight="SemiBold" />
                  </Button>

                  <!-- Row 4: *, 0, # -->
                  <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="*">
                    <TextBlock Text="*" FontSize="22" FontWeight="SemiBold" Margin="0,-4,0,0" />
                  </Button>
                  <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="0">
                    <TextBlock Text="0" FontSize="20" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource DtmfKeypadButtonStyle}" Command="{Binding SendDtmfCommand}" CommandParameter="#">
                    <TextBlock Text="#" FontSize="18" FontWeight="SemiBold" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Right Column: Recent Calls Panel -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Recent Calls Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="最近通话"
            />
            <Border
              Margin="10,0,0,0"
              Padding="6,2"
              CornerRadius="10"
              Background="{DynamicResource SubtleFillColorSecondaryBrush}"
              VerticalAlignment="Center"
            >
              <TextBlock
                Text="{Binding CallHistory.Count}"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AppTextSecondaryBrush}"
              />
            </Border>
          </StackPanel>

          <!-- Safe Clear History Button (Prompts confirmation dialog) -->
          <ui:Button
            Grid.Column="1"
            Appearance="Transparent"
            Command="{Binding ClearHistoryCommand}"
            Icon="{ui:SymbolIcon Symbol=Delete24}"
            Content="清空"
          />
        </Grid>

        <!-- History List Area -->
        <Border Grid.Row="1" Background="Transparent">
          <Grid>
            <!-- Empty State -->
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding CallHistory.Count, Converter={StaticResource InvertBoolToVis}}"
            >
              <ui:SymbolIcon
                FontSize="48"
                Foreground="{DynamicResource AppTextTertiaryBrush}"
                Symbol="History24"
              />
              <TextBlock
                Margin="0,16,0,0"
                FontSize="15"
                Foreground="{DynamicResource AppTextSecondaryBrush}"
                Text="暂无最近通话记录"
              />
            </StackPanel>

            <!-- Call History Records List -->
            <ListView
              ItemsSource="{Binding CallHistory}"
              BorderThickness="0"
              Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.CanContentScroll="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
            >
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,0,0,8"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListViewItem">
                        <Border
                          Background="{DynamicResource AppCardBrush}"
                          BorderBrush="{DynamicResource AppCardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="16,12"
                        >
                          <ContentPresenter/>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListView.ItemContainerStyle>

              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Semantic Call Status Direction Icon -->
                    <Border
                      Grid.Column="0"
                      Width="42"
                      Height="42"
                      CornerRadius="21"
                      Background="{DynamicResource AppInputBrush}"
                      Margin="0,0,14,0"
                    >
                      <ui:SymbolIcon
                        FontSize="20"
                        Foreground="{Binding Converter={StaticResource CallRecordColor}}"
                        Symbol="{Binding Converter={StaticResource CallRecordSymbol}}"
                      />
                    </Border>

                    <!-- Phone Number, Name & Time/Duration -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding PhoneNumber}"
                        Margin="0,0,0,3"
                      />
                      <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                      >
                        <Run Text="{Binding FormattedTime, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding FormattedDuration, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>

                    <!-- Row Actions: Quick Redial & More Options Dropdown -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <!-- Quick Redial Button -->
                      <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Command="{Binding DataContext.RedialCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Icon="{ui:SymbolIcon Symbol=Call24, FontSize=18}"
                        Content="回拨"
                      />

                      <!-- More Options Dropdown Button -->
                      <ui:Button
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Symbol=MoreHorizontal24, FontSize=20}"
                        Click="OnMoreOptionsClick"
                        ToolTip="更多操作"
                      >
                        <ui:Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="填入拨号盘" Click="OnFillNumberClick">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="复制号码" Click="OnCopyNumberClick">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="删除此记录" Click="OnDeleteRecordClick">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{DynamicResource AppDangerBrush}" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </ui:Button.ContextMenu>
                      </ui:Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>
