<Page
  x:Class="VoWin.Views.Pages.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="关于"
  d:DataContext="{d:DesignInstance vm:AboutViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="850"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource AppTextPrimaryBrush}"
  Foreground="{DynamicResource AppTextPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="24,18,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Style="{DynamicResource AppPageTitleStyle}" Text="关于" />
        <TextBlock Style="{DynamicResource AppPageSubtitleStyle}" Text="项目简介、开发者主页、说明与赞助支持" />
      </StackPanel>
    </Grid>

    <!-- Main Scrollable Content Area -->
    <ScrollViewer
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      HorizontalContentAlignment="Stretch"
      Padding="0,0,12,0"
    >
      <StackPanel MaxWidth="920" HorizontalAlignment="Center">

        <!-- Card 1: 项目简介 (Project Introduction) -->
        <Border
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="24,20"
          Margin="0,0,0,16"
        >
          <Border.Effect>
            <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- App Logo -->
            <Border
              Grid.Column="0"
              Width="68"
              Height="68"
              CornerRadius="16"
              Background="{DynamicResource AppInputBrush}"
              BorderBrush="{DynamicResource AppCardBorderBrush}"
              BorderThickness="1"
              VerticalAlignment="Top"
              Margin="0,0,20,0"
            >
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.10" ShadowDepth="3" Color="#000000" />
              </Border.Effect>
              <Image
                Source="pack://application:,,,/Assets/vowin.png"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>

            <!-- Introduction Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                <Border Margin="12,0,0,0" Padding="8,3" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AppVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" />
                </Border>
                <Border Margin="8,0,0,0" Padding="8,3" Background="{DynamicResource AppInputBrush}" CornerRadius="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding BuildInfo}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Border>
              </StackPanel>

              <TextBlock
                Margin="0,10,0,0"
                FontSize="13"
                LineHeight="22"
                TextWrapping="Wrap"
                Foreground="{DynamicResource AppTextPrimaryBrush}"
                Text="{Binding ProjectDescription}"
              />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Card 2: 开发者与项目页面 (Developer & Project Repository) -->
        <Border
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="20,18"
          Margin="0,0,0,16"
        >
          <Border.Effect>
            <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Code24" Foreground="{DynamicResource AppAccentBrush}" FontSize="20" Margin="0,0,8,0" />
                <TextBlock Text="开发者与项目主页" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="GitHub Open Source" VerticalAlignment="Center" />
            </Grid>

            <!-- Repository Action Box -->
            <Border
              Background="{DynamicResource AppInputBrush}"
              BorderBrush="{DynamicResource AppCardBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,12"
              Margin="0,0,0,10"
            >
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border
                  Grid.Column="0"
                  Width="36"
                  Height="36"
                  CornerRadius="8"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"
                >
                  <ui:SymbolIcon Symbol="BranchFork24" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Repo Address -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="GitHub 项目仓库链接" FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                  <ui:TextBox
                    Margin="0,3,0,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppAccentBrush}"
                    Text="{Binding GitHubUrl, Mode=OneWay}"
                    IsReadOnly="True"
                    BorderThickness="0"
                    Background="Transparent"
                    Padding="0"
                    Cursor="Arrow"
                    Focusable="True"
                    ToolTip="GitHub 官方开源仓库链接（已设为只读保护，不可删除）"
                  />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <ui:Button
                    Appearance="Primary"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding GitHubUrl}"
                    Icon="{ui:SymbolIcon Symbol=Globe24}"
                    Content="访问 GitHub 仓库"
                    Margin="0,0,8,0"
                    Padding="14,7"
                  />
                  <ui:Button
                    Appearance="Secondary"
                    Command="{Binding CopyUrlCommand}"
                    CommandParameter="{Binding GitHubUrl}"
                    Icon="{ui:SymbolIcon Symbol=Copy24}"
                    Content="复制链接"
                    Padding="12,7"
                  />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Secondary Links: Profile / Issues -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
              <ui:Button
                Appearance="Transparent"
                Command="{Binding OpenUrlCommand}"
                CommandParameter="{Binding GitHubProfileUrl}"
                Icon="{ui:SymbolIcon Symbol=Person24}"
                Content="开发者 GitHub 主页"
                FontSize="12"
                Margin="0,0,8,0"
              />
              <ui:Button
                Appearance="Transparent"
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/unikgyd/VoWin/issues"
                Icon="{ui:SymbolIcon Symbol=QuestionCircle24}"
                Content="提交 Issue 反馈"
                FontSize="12"
              />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Card 3: 赞助与支持 (Sponsorship: USDT-TRON / USDT-BSC / USDT-Polygon) -->
        <Border
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="20,18"
          Margin="0,0,0,16"
        >
          <Border.Effect>
            <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <!-- Card Header -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Heart24" Foreground="{DynamicResource AppDangerBrush}" FontSize="20" Margin="0,0,8,0" />
                <TextBlock Text="赞助与支持 (Sponsorship)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Network Badges -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource AppDangerSoftBrush}" BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1" Padding="7,3" CornerRadius="5" Margin="0,0,6,0">
                  <TextBlock Text="USDT · TRC-20" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}" />
                </Border>
                <Border Background="{DynamicResource AppWarningSoftBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" Padding="7,3" CornerRadius="5" Margin="0,0,6,0">
                  <TextBlock Text="USDT · BEP-20" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}" />
                </Border>
                <Border Background="{DynamicResource AppAccentSoftBrush}" BorderBrush="{DynamicResource AppAccentSoftBorderBrush}" BorderThickness="1" Padding="7,3" CornerRadius="5">
                  <TextBlock Text="USDT · Polygon" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                </Border>
              </StackPanel>
            </Grid>

            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource AppTextSecondaryBrush}"
              Margin="0,0,0,14"
              Text="如果您觉得本项目对您的工作或研究有所帮助，欢迎通过区块链加密网络请作者喝杯咖啡 ☕，支持项目的持续维护与更新！"
            />

            <!-- 3 Columns: USDT-TRON (TRC-20) / USDT-BSC (BEP-20) / USDT-Polygon -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Column 0: USDT - TRON (TRC20) -->
              <Border
                Grid.Column="0"
                Margin="0,0,6,0"
                Background="{DynamicResource AppInputBrush}"
                BorderBrush="{DynamicResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,14"
              >
                <StackPanel>
                  <!-- Channel Header -->
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AppSuccessSoftBrush}" BorderBrush="#26A17B" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="₮" FontSize="12" FontWeight="Bold" Foreground="#26A17B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                      </Border>
                      <TextBlock Text="USDT-TRON" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AppDangerSoftBrush}" Padding="5,2" CornerRadius="4">
                      <TextBlock Text="TRC-20" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}" />
                    </Border>
                  </Grid>

                  <!-- QR Code Container -->
                  <Border
                    Background="#FFFFFF"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6"
                    Width="160"
                    Height="160"
                    HorizontalAlignment="Center"
                  >
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.06" ShadowDepth="2" Color="#000000" />
                    </Border.Effect>
                    <Image
                      Source="{Binding TronQrCode}"
                      RenderOptions.BitmapScalingMode="NearestNeighbor"
                      Width="146"
                      Height="146"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                    />
                  </Border>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,6">
                    <ui:SymbolIcon Symbol="QrCode24" FontSize="12" Foreground="{DynamicResource AppDangerBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="扫码转账 (TRC-20)" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Address Box -->
                  <Border
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,4"
                    Margin="0,0,0,8"
                  >
                    <ui:TextBox
                      FontSize="10"
                      FontFamily="Consolas, Segoe UI"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                      Text="{Binding TronAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      BorderThickness="0"
                      Background="Transparent"
                      Padding="0"
                      TextAlignment="Center"
                      ToolTip="点击可全选复制或直接编辑 TRON 收款地址"
                    />
                  </Border>

                  <!-- Action Buttons -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <ui:Button
                      Appearance="Primary"
                      Command="{Binding CopyTronAddressCommand}"
                      Icon="{ui:SymbolIcon Symbol=Copy24}"
                      Content="复制地址"
                      FontSize="11"
                      Padding="10,5"
                      Margin="0,0,6,0"
                    />
                    <ui:Button
                      Appearance="Secondary"
                      Command="{Binding SaveTronQrCodeCommand}"
                      Icon="{ui:SymbolIcon Symbol=Save24}"
                      Content="保存"
                      FontSize="11"
                      Padding="8,5"
                    />
                  </StackPanel>

                  <TextBlock
                    FontSize="9.5"
                    LineHeight="13"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{DynamicResource AppTextTertiaryBrush}"
                    Text="💡 仅限波场 TRON (TRC-20) 资产"
                  />
                </StackPanel>
              </Border>

              <!-- Column 1: USDT - BSC (BEP-20) -->
              <Border
                Grid.Column="1"
                Margin="3,0,3,0"
                Background="{DynamicResource AppInputBrush}"
                BorderBrush="{DynamicResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,14"
              >
                <StackPanel>
                  <!-- Channel Header -->
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AppSuccessSoftBrush}" BorderBrush="#26A17B" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="₮" FontSize="12" FontWeight="Bold" Foreground="#26A17B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                      </Border>
                      <TextBlock Text="USDT-BSC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AppWarningSoftBrush}" Padding="5,2" CornerRadius="4">
                      <TextBlock Text="BEP-20" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}" />
                    </Border>
                  </Grid>

                  <!-- QR Code Container -->
                  <Border
                    Background="#FFFFFF"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6"
                    Width="160"
                    Height="160"
                    HorizontalAlignment="Center"
                  >
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.06" ShadowDepth="2" Color="#000000" />
                    </Border.Effect>
                    <Image
                      Source="{Binding BscQrCode}"
                      RenderOptions.BitmapScalingMode="NearestNeighbor"
                      Width="146"
                      Height="146"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                    />
                  </Border>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,6">
                    <ui:SymbolIcon Symbol="QrCode24" FontSize="12" Foreground="{DynamicResource AppWarningBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="扫码转账 (BSC BEP-20)" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Address Box -->
                  <Border
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,4"
                    Margin="0,0,0,8"
                  >
                    <ui:TextBox
                      FontSize="10"
                      FontFamily="Consolas, Segoe UI"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                      Text="{Binding BscAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      BorderThickness="0"
                      Background="Transparent"
                      Padding="0"
                      TextAlignment="Center"
                      ToolTip="点击可全选复制或直接编辑 BSC 收款地址"
                    />
                  </Border>

                  <!-- Action Buttons -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <ui:Button
                      Appearance="Primary"
                      Command="{Binding CopyBscAddressCommand}"
                      Icon="{ui:SymbolIcon Symbol=Copy24}"
                      Content="复制地址"
                      FontSize="11"
                      Padding="10,5"
                      Margin="0,0,6,0"
                    />
                    <ui:Button
                      Appearance="Secondary"
                      Command="{Binding SaveBscQrCodeCommand}"
                      Icon="{ui:SymbolIcon Symbol=Save24}"
                      Content="保存"
                      FontSize="11"
                      Padding="8,5"
                    />
                  </StackPanel>

                  <TextBlock
                    FontSize="9.5"
                    LineHeight="13"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{DynamicResource AppTextTertiaryBrush}"
                    Text="💡 仅限 BNB Smart Chain (BEP-20)"
                  />
                </StackPanel>
              </Border>

              <!-- Column 2: USDT - Polygon -->
              <Border
                Grid.Column="2"
                Margin="6,0,0,0"
                Background="{DynamicResource AppInputBrush}"
                BorderBrush="{DynamicResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,14"
              >
                <StackPanel>
                  <!-- Channel Header -->
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AppSuccessSoftBrush}" BorderBrush="#26A17B" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="₮" FontSize="12" FontWeight="Bold" Foreground="#26A17B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                      </Border>
                      <TextBlock Text="USDT-Polygon" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AppAccentSoftBrush}" Padding="5,2" CornerRadius="4">
                      <TextBlock Text="Polygon" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                    </Border>
                  </Grid>

                  <!-- QR Code Container -->
                  <Border
                    Background="#FFFFFF"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6"
                    Width="160"
                    Height="160"
                    HorizontalAlignment="Center"
                  >
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.06" ShadowDepth="2" Color="#000000" />
                    </Border.Effect>
                    <Image
                      Source="{Binding PolygonQrCode}"
                      RenderOptions.BitmapScalingMode="NearestNeighbor"
                      Width="146"
                      Height="146"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                    />
                  </Border>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,6">
                    <ui:SymbolIcon Symbol="QrCode24" FontSize="12" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="扫码转账 (Polygon)" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Address Box -->
                  <Border
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,4"
                    Margin="0,0,0,8"
                  >
                    <ui:TextBox
                      FontSize="10"
                      FontFamily="Consolas, Segoe UI"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                      Text="{Binding PolygonAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      BorderThickness="0"
                      Background="Transparent"
                      Padding="0"
                      TextAlignment="Center"
                      ToolTip="点击可全选复制或直接编辑 Polygon 收款地址"
                    />
                  </Border>

                  <!-- Action Buttons -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <ui:Button
                      Appearance="Primary"
                      Command="{Binding CopyPolygonAddressCommand}"
                      Icon="{ui:SymbolIcon Symbol=Copy24}"
                      Content="复制地址"
                      FontSize="11"
                      Padding="10,5"
                      Margin="0,0,6,0"
                    />
                    <ui:Button
                      Appearance="Secondary"
                      Command="{Binding SavePolygonQrCodeCommand}"
                      Icon="{ui:SymbolIcon Symbol=Save24}"
                      Content="保存"
                      FontSize="11"
                      Padding="8,5"
                    />
                  </StackPanel>

                  <TextBlock
                    FontSize="9.5"
                    LineHeight="13"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{DynamicResource AppTextTertiaryBrush}"
                    Text="💡 仅限 Polygon (PoS) 链上资产"
                  />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Unified Safety Tip -->
            <Border
              Background="{DynamicResource SubtleFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource AppCardBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,8"
              Margin="0,6,0,0"
            >
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock
                  FontSize="11"
                  Foreground="{DynamicResource AppTextSecondaryBrush}"
                  VerticalAlignment="Center"
                  Text="安全提示：转账时请务必核对所选区块链协议与充值网络（TRC-20 / BEP-20 / Polygon），跨链充错将导致资产无法找回。"
                />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Card 4: 项目说明 (Project Notes & Instructions) -->
        <Border
          Background="{DynamicResource AppCardBrush}"
          BorderBrush="{DynamicResource AppCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="20,18"
          Margin="0,0,0,16"
        >
          <Border.Effect>
            <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="2" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="DocumentText24" Foreground="{DynamicResource AppAccentBrush}" FontSize="20" Margin="0,0,8,0" />
                <TextBlock Text="项目说明" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>

              <!-- 复制说明按钮 -->
              <ui:Button
                Grid.Column="1"
                Appearance="Secondary"
                Command="{Binding CopyProjectNotesCommand}"
                Icon="{ui:SymbolIcon Symbol=Copy24}"
                Content="复制说明文本"
                FontSize="11"
                Padding="12,5"
              />
            </Grid>

            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource AppTextSecondaryBrush}"
              Margin="0,0,0,10"
              Text="以下为项目的特别说明、使用指南与免责声明（只读保护模式，不可删除）："
            />

            <!-- Notes Content Text Area (不可删除，只读保护) -->
            <Border
              Background="{DynamicResource AppInputBrush}"
              BorderBrush="{DynamicResource AppCardBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,12"
            >
              <ui:TextBox
                Text="{Binding ProjectNotes, Mode=OneWay}"
                IsReadOnly="True"
                FontSize="12.5"
                FontFamily="Consolas, Microsoft YaHei, Segoe UI"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                MinHeight="90"
                BorderThickness="0"
                Background="Transparent"
                Padding="0"
                Cursor="Arrow"
                Focusable="True"
                ToolTip="项目说明与免责声明（已设为只读保护，不可删除，可点击右上角复制）"
              />
            </Border>
          </StackPanel>
        </Border>

        <!-- Status Toast Banner at Bottom -->
        <Border
          Background="{DynamicResource ControlFillColorDefaultBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="14,8"
          Margin="0,0,0,16"
        >
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
            <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource AppAccentBrush}"
              Text="{Binding StatusMessage, FallbackValue='就绪'}"
            />
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
