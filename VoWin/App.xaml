<Application
    x:Class="VoWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
    Exit="OnExit"
    ShutdownMode="OnMainWindowClose"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局开关控件开启状态翡翠绿主题 (All Toggle Switches & Toggle Buttons Green When ON) -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#10B981" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#059669" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#047857" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#10B981" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#059669" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#047857" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#4D10B981" />

            <!-- 原生 Primitives.ToggleButton 选中高亮绿色覆盖 -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#10B981" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#059669" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#047857" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#10B981" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#047857" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
