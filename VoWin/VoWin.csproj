<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>vowin.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Use the installed .NET 10 Desktop Runtime; bundle only communication dependencies. -->
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Release builds must supply this with -p:Version=x.y.z. The fallback
         keeps local developer builds deterministic. -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Version)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="vowin.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0 " />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoWin.Tests" />
    <ProjectReference Include="..\voSharp\src\VoSharp.Kernel\VoSharp.Kernel.csproj" />
    <ProjectReference Include="..\voSharp\src\VoSharp.HostIms\VoSharp.HostIms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 3.6 KiB read-only modem identity helper; source/build instructions beside it. -->
    <EmbeddedResource Include="..\qmi\tools\qdc-identity\vowin-qdc-identity.armv7" LogicalName="VoWin.QdcIdentity.armv7" />
  </ItemGroup>

  <!-- Old releases placed the removed Go LPA helper in the normal output folder.
       Remove it before build/publish so incremental builds cannot ship a stale copy. -->
  <Target Name="RemoveLegacyEuiccLpaWorker" BeforeTargets="Build;Publish">
    <Delete Files="$(OutputPath)native\VoSharp.EuiccLpaWorker.exe;$(OutputPath)native\VoSharp.EuiccLpaWorker.LICENSE.txt;$(PublishDir)native\VoSharp.EuiccLpaWorker.exe;$(PublishDir)native\VoSharp.EuiccLpaWorker.LICENSE.txt" />
  </Target>

  <Target Name="RemoveSingleFileSymbols" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <SingleFileSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(SingleFileSymbols)" />
  </Target>

  <!-- The archive is an assembly resource, not a sidecar or an arbitrary PATH dependency. -->
  <PropertyGroup>
    <!-- Debug/source launches need the same protected, versioned owner as releases.
         Do not silently fall back to a stale executable saved by an old release. -->
    <VoWinRuntimeBundle Condition="'$(VoWinRuntimeBundle)' == '' And Exists('$(MSBuildProjectDirectory)/../packaging/runtime.zip')">$(MSBuildProjectDirectory)/../packaging/runtime.zip</VoWinRuntimeBundle>
  </PropertyGroup>
  <ItemGroup Condition="'$(VoWinRuntimeBundle)' != ''">
    <EmbeddedResource Include="$(VoWinRuntimeBundle)" LogicalName="VoWin.Runtime.zip" />
  </ItemGroup>
  <Target Name="ValidateRuntimeBundle" BeforeTargets="PrepareForPublish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="'$(VoWinRuntimeBundle)' == '' Or !Exists('$(VoWinRuntimeBundle)')"
           Text="Prepare packaging/runtime.zip first, then supply -p:VoWinRuntimeBundle=absolute-path-to-runtime.zip. Incomplete release packages are not supported." />
    <Error Condition="'$(SelfContained)' == 'true'" Text="VoWin releases use the installed .NET Desktop Runtime; use --self-contained false." />
  </Target>
  <ItemGroup>
    <None Remove="Assets\*.png" />
    <None Remove="Assets\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.jpg" />
    <Content Include="Assets\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
